@model IEnumerable<WebApplication2.Models.VerificationQueueItemViewModel>

    @{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Review Queue";

    var allItems = (Model ?? Enumerable.Empty<WebApplication2.Models.VerificationQueueItemViewModel>())
        .GroupBy(x => new { x.TestRequestID, x.TestTypeID })
        .Select(g => g.OrderByDescending(x => x.TestResultID).First())
        .Where(x =>
            string.Equals(x.LatestVerificationDecision, "Returned", StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.LatestVerificationDecision, "Return", StringComparison.OrdinalIgnoreCase)
            || string.Equals(x.LatestVerificationDecision, "Rejected", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(x => x.LatestVerificationDateTime ?? x.CompletionDateTime)
        .ToList();
    }

    <link href="~/css/dashboardstyles.css" rel="stylesheet" />

    <style>
        .review-container {
            background: #fff;
            border: 1px solid #dbe3ec;
            border-radius: 18px;
            padding: 28px;
        }

        .review-card {
            border: 1px solid #dbe3ec;
            border-left: 4px solid #dc3545;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 16px;
            background: #f8fafc;
        }

        .review-badge {
            display: inline-block;
            padding: 5px 11px;
            border-radius: 20px;
            background: #fee2e2;
            color: #991b1b;
            font-size: .8rem;
            font-weight: 700;
        }

        .detail-label {
            display: block;
            color: #64748b;
            font-size: .82rem;
            margin-bottom: 3px;
        }

        .detail-value {
            color: #1f2937;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .return-reason {
            border: 1px solid #fed7aa;
            background: #fff7ed;
            color: #9a3412;
            border-radius: 10px;
            padding: 12px 15px;
            margin-top: 16px;
        }

        .legacy-warning {
            border: 1px solid #fca5a5;
            background: #fef2f2;
            color: #991b1b;
            border-radius: 10px;
            padding: 12px 15px;
            margin-top: 16px;
        }

        .empty-state {
            text-align: center;
            padding: 55px 20px;
            border: 1px dashed #cbd5e1;
            border-radius: 14px;
            background: #f8fafc;
        }

        .btn-review {
            display: inline-block;
            padding: 9px 15px;
            background: #0d6efd;
            color: #fff !important;
            text-decoration: none;
            border-radius: 9px;
            font-weight: 600;
        }

            .btn-review:hover {
                background: #0b5ed7;
            }

        .btn-back {
            display: inline-block;
            padding: 9px 15px;
            border: 1px solid #cbd5e1;
            color: #334155 !important;
            text-decoration: none;
            border-radius: 9px;
        }
    </style>

    <div class="main-content">
        <div class="container-fluid py-4">
            <div class="review-container">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div>
                        <h1 class="mb-2">Review Queue</h1>
                        <p class="text-muted mb-0">Tests returned for correction or recapture. A test disappears here after a newer result is captured; its history remains available in Verification Queue.</p>
                    </div>
                    <a asp-controller="LabTechnician" asp-action="Dashboard" class="btn-back">← Dashboard</a>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <div>
                        <span class="text-muted">Tests requiring recapture</span>
                        <h4 class="mb-0">@allItems.Count</h4>
                    </div>
                    <input id="reviewSearch" type="search" class="form-control" style="max-width:340px;" placeholder="Search patient, request, barcode or test..." aria-label="Search review queue" />
                </div>

                @if (allItems.Count == 0)
            {
                <div class="empty-state">
                    <h4>No tests awaiting recapture</h4>
                    <p class="text-muted mb-0">Returned or rejected tests will appear here until a new result has been captured.</p>
                </div>
            }
            else
            {
                <div id="reviewList">
                    @foreach (var item in allItems)
                    {
                        var searchText = string.Join(" ", new[] { item.RequestNumber ?? "", item.Barcode ?? "", item.PatientName ?? "", item.PatientNumber ?? "", item.TestName ?? "" });
                    <article class="review-card" data-search="@searchText.ToLowerInvariant()">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                            <div>
                                <span class="review-badge">@item.LatestVerificationDecision</span>
                                <h4 class="mt-3 mb-3">@(string.IsNullOrWhiteSpace(item.TestName) ? "Unnamed test" : item.TestName)</h4>
                            </div>
                            <div class="text-md-end">
                                <span class="detail-label">Request</span>
                                <span class="detail-value">@(string.IsNullOrWhiteSpace(item.RequestNumber) ? $"Request #{item.TestRequestID}" : item.RequestNumber)</span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <span class="detail-label">Patient</span>
                                <div class="detail-value">@(string.IsNullOrWhiteSpace(item.PatientName) ? "Not available" : item.PatientName)</div>
                                <small class="text-muted">Patient number: @(string.IsNullOrWhiteSpace(item.PatientNumber) ? "Not available" : item.PatientNumber)</small>
                            </div>
                            <div class="col-md-4">
                                <span class="detail-label">Barcode</span>
                                <div class="detail-value">@(string.IsNullOrWhiteSpace(item.Barcode) ? "Not available" : item.Barcode)</div>
                            </div>
                            <div class="col-md-4">
                                <span class="detail-label">Decision recorded</span>
                                <div class="detail-value">@(item.LatestVerificationDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not available")</div>
                            </div>
                            <div class="col-md-4">
                                <span class="detail-label">Current result</span>
                                <div class="detail-value">
                                    @(string.IsNullOrWhiteSpace(item.Result) ? "No result available" : item.Result)
                                    @if (!string.IsNullOrWhiteSpace(item.Units)) { <span> @item.Units</span> }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <span class="detail-label">Reference range</span>
                                <div class="detail-value">
                                    @if (item.NormalRangeMin.HasValue || item.NormalRangeMax.HasValue)
                                        {
                                    <span>@(item.NormalRangeMin?.ToString() ?? "—") – @(item.NormalRangeMax?.ToString() ?? "—") @item.Units</span>
                                        }
                                        else { <span>Not available</span> }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <span class="detail-label">Result status</span>
                                <div class="detail-value">@(string.IsNullOrWhiteSpace(item.ResultStatus) ? "Not available" : item.ResultStatus) @if (item.IsAbnormal) { <span class="text-danger">(Abnormal)</span> }</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.LatestVerificationReason))
                            {
                        <div class="return-reason">
                            <strong>Reason for @((item.LatestVerificationDecision ?? "").Equals("Rejected", StringComparison.OrdinalIgnoreCase) ? "rejection" : "return")</strong>
                            <p class="mb-0 mt-1">@item.LatestVerificationReason</p>
                        </div>
                            }
                            else
                            {
                        <div class="legacy-warning">
                            <strong>Missing reason on an older decision</strong>
                            <p class="mb-0 mt-1">This historical decision has no reason saved. New return decisions require a reason before they can be saved.</p>
                        </div>
                            }

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
                            <small class="text-muted">Result completed: @(item.CompletionDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not available")</small>
                            <a asp-controller="LabTechnician" asp-action="CaptureResults" asp-route-sampleReceiptId="@item.SampleReceiptID" asp-route-testTypeId="@item.TestTypeID" class="btn-review">
                                <i class="fa-solid fa-rotate me-1"></i> Recapture this test
                            </a>
                        </div>
                    </article>
                    }
                </div>
                <div id="noSearchResults" class="empty-state" style="display:none;">
                    <h5>No matching tests</h5>
                    <p class="text-muted mb-0">Try a different patient, request number, barcode or test name.</p>
                </div>
            }
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            (() => {
                const search = document.getElementById("reviewSearch");
                if (!search) return;
                search.addEventListener("input", () => {
                    const query = search.value.trim().toLowerCase();
                    const cards = Array.from(document.querySelectorAll(".review-card"));
                    let visible = 0;
                    cards.forEach(card => {
                        const match = (card.dataset.search || "").includes(query);
                        card.style.display = match ? "" : "none";
                        if (match) visible++;
                    });
                    const noResults = document.getElementById("noSearchResults");
                    if (noResults) noResults.style.display = cards.length > 0 && visible === 0 ? "block" : "none";
                });
            })();
        </script>
    }
