@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Review Queue";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>

    .page-container {
        padding: 0;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .review-card {
        background: #f8fafc;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 22px;
        border-left: 4px solid #dc3545;
        border-top: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        margin-right: 6px;
        margin-top: 5px;
        font-weight: 600;
    }

    .badge-review {
        background: #dc3545;
        color: white;
    }

    .badge-stat {
        background: #f4a261;
        color: black;
    }

    .badge-returned {
        background: #e5e7eb;
        color: #374151;
    }

    .badge-resubmitted {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .badge-verified {
        background: #198754;
        color: white;
    }

    .note-box {
        background: #ffffff;
        border-radius: 12px;
        padding: 16px;
        margin-top: 15px;
        border-left: 4px solid #ffc107;
        border-top: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
    }

    .original-result {
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 12px;
        padding: 18px;
        margin-top: 18px;
    }

    .result-row {
        padding: 12px 0;
        border-bottom: 1px solid #e2e8f0;
    }

        .result-row:last-child {
            border-bottom: none;
        }

    .result-name {
        font-weight: 700;
        color: #1f2937;
    }

    .result-value {
        font-weight: 600;
        color: #374151;
    }

    .normal-range {
        font-size: 0.82rem;
        color: #64748b;
    }

    .technician-note {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 9px;
        padding: 10px 12px;
        margin-top: 8px;
        color: #1e3a8a;
        font-size: 0.84rem;
    }

    .history {
        margin-top: 20px;
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 12px;
        padding: 20px;
    }

    .history-item {
        position: relative;
        padding: 0 0 20px 25px;
        border-left: 2px solid #cbd5e1;
        margin-left: 8px;
    }

        .history-item:last-child {
            border-left: none;
            padding-bottom: 0;
        }

    .history-dot {
        position: absolute;
        left: -7px;
        top: 0;
        width: 12px;
        height: 12px;
        background: #0d6efd;
        border-radius: 50%;
    }

    .history-title {
        font-weight: 700;
        color: #1f2937;
    }

    .history-meta {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 3px;
    }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .btn-outline-custom {
        background: white;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-outline-custom:hover {
            background: #eff6ff;
        }

    .filter-box,
    .form-control,
    .form-select {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #ffffff;
            color: #1f2937;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    .text-muted {
        color: #6b7280 !important;
    }

    h1,
    h4,
    h5,
    p,
    strong {
        color: #1f2937;
    }
</style>


<!-- MAIN CONTENT -->
<div class="main-content">

    <div class="page-container">

        <div class="card-dark">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h1>
                        Review Queue
                    </h1>

                    <p class="text-muted">
                        Results returned after verification requiring technician review and possible recapture.
                    </p>

                </div>

                <a asp-controller="Home"
                   asp-action="LabTechnicianDashboard"
                   class="btn-dark-custom">

                    ← Dashboard

                </a>

            </div>


            <!-- FILTERS -->
            <div class="row g-3 mb-4">

                <div class="col-md-4">

                    <input class="form-control filter-box"
                           placeholder="Search request number..." />

                </div>

                <div class="col-md-4">

                    <select class="form-select filter-box">

                        <option>All Priorities</option>
                        <option>STAT</option>
                        <option>Routine</option>

                    </select>

                </div>

                <div class="col-md-4">

                    <select class="form-select filter-box">

                        <option>All Review Statuses</option>
                        <option>To Be Reviewed</option>
                        <option>Returned For Correction</option>
                        <option>Resubmitted</option>

                    </select>

                </div>

            </div>


            <!-- REVIEW ITEM -->
            <div class="review-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="flex-grow-1">

                        <h4>
                            REQ-2026-00124
                        </h4>

                        <p class="mb-2">
                            <strong>Patient:</strong>
                            Baloyi, Thabo
                        </p>

                        <p class="mb-2">
                            <strong>Test:</strong>
                            Full Blood Count + Differential
                        </p>

                        <p class="mb-2">
                            <strong>Technician:</strong>
                            Technician A. Smith
                        </p>

                        <span class="status-badge badge-review">
                            To Be Reviewed
                        </span>

                        <span class="status-badge badge-stat">
                            STAT
                        </span>

                        <span class="status-badge badge-returned">
                            Returned For Correction
                        </span>


                        <!-- ORIGINAL RESULTS -->
                        <div class="original-result">

                            <h5 class="mb-3">
                                Original Results
                            </h5>


                            <!-- HAEMOGLOBIN -->
                            <div class="result-row">

                                <div class="row">

                                    <div class="col-md-3">

                                        <div class="result-name">
                                            Haemoglobin
                                        </div>

                                        <div class="result-value">
                                            8.7 g/dL
                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <div class="normal-range">
                                            Normal: 12.0 – 16.0 g/dL
                                        </div>

                                    </div>

                                    <div class="col-md-6">

                                        <div class="technician-note">

                                            <strong>
                                                Technician Notes:
                                            </strong>

                                            Low haemoglobin observed.
                                            Sample processed without issues.

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- WCC -->
                            <div class="result-row">

                                <div class="row">

                                    <div class="col-md-3">

                                        <div class="result-name">
                                            White Cell Count
                                        </div>

                                        <div class="result-value">
                                            14.2 x10⁹/L
                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <div class="normal-range">
                                            Normal: 4.0 – 11.0 x10⁹/L
                                        </div>

                                    </div>

                                    <div class="col-md-6">

                                        <div class="technician-note">

                                            <strong>
                                                Technician Notes:
                                            </strong>

                                            Elevated WCC recorded.
                                            Result checked against analyser output.

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- PLATELETS -->
                            <div class="result-row">

                                <div class="row">

                                    <div class="col-md-3">

                                        <div class="result-name">
                                            Platelets
                                        </div>

                                        <div class="result-value">
                                            455 x10⁹/L
                                        </div>

                                    </div>

                                    <div class="col-md-3">

                                        <div class="normal-range">
                                            Normal: 150 – 450 x10⁹/L
                                        </div>

                                    </div>

                                    <div class="col-md-6">

                                        <div class="technician-note">

                                            <strong>
                                                Technician Notes:
                                            </strong>

                                            Platelet count slightly above
                                            expected range.

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- VERIFIER NOTES -->
                        <div class="note-box">

                            <strong>
                                Notes From Verifying Technician
                            </strong>

                            <p class="mb-0 mt-2">

                                White Cell Count appears inconsistent with
                                previous patient history. Please confirm values.

                            </p>

                            <small class="text-muted">
                                Verified by Technician M. Jacobs
                            </small>

                        </div>


                        <!-- FULL HISTORY -->
                        <div class="history">

                            <h5 class="mb-4">
                                Verification History
                            </h5>


                            <div class="history-item">

                                <div class="history-dot"></div>

                                <div class="history-title">
                                    Results Captured
                                </div>

                                <div class="history-meta">
                                    Technician A. Smith • 20 Aug 2026 • 09:42
                                </div>

                                <p class="mb-0 mt-2">
                                    Original test results captured and submitted for verification.
                                </p>

                            </div>


                            <div class="history-item">

                                <div class="history-dot"></div>

                                <div class="history-title">
                                    Submitted For Verification
                                </div>

                                <div class="history-meta">
                                    Technician A. Smith • 20 Aug 2026 • 10:05
                                </div>

                                <p class="mb-0 mt-2">
                                    Results submitted to the verification queue.
                                </p>

                            </div>


                            <div class="history-item">

                                <div class="history-dot"></div>

                                <div class="history-title">
                                    Verification Rejected
                                </div>

                                <div class="history-meta">
                                    Technician M. Jacobs • 20 Aug 2026 • 10:18
                                </div>

                                <p class="mb-0 mt-2">
                                    White Cell Count requires confirmation.
                                </p>

                            </div>


                            <div class="history-item">

                                <div class="history-dot"></div>

                                <div class="history-title">
                                    Returned To Technician
                                </div>

                                <div class="history-meta">
                                    System • 20 Aug 2026 • 10:19
                                </div>

                                <p class="mb-0 mt-2">
                                    Results returned for correction and recapture.
                                </p>

                            </div>


                            <div class="history-item">

                                <div class="history-dot"></div>

                                <div class="history-title">
                                    Awaiting Recapture
                                </div>

                                <div class="history-meta">
                                    Current Status
                                </div>

                                <p class="mb-0 mt-2">
                                    Technician must review the original values,
                                    make corrections where necessary and provide
                                    recapture notes.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- ACTIONS -->
                    <div class="text-end ms-4">

                        <p class="text-danger fw-bold">
                            Requires technician review
                        </p>

                        <a asp-controller="LabTechnician"
                           asp-action="CaptureResults"
                           class="btn-dark-custom mb-2">

                            <i class="fa-solid fa-rotate"></i>
                            Recapture Results

                        </a>

                        <br />

                        <a asp-controller="LabTechnician"
                           asp-action="TestDetail"
                           class="btn-outline-custom">

                            View Details

                        </a>

                    </div>

                </div>

            </div>


            <!-- SECOND REVIEW ITEM -->
            <div class="review-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="flex-grow-1">

                        <h4>
                            REQ-2026-00131
                        </h4>

                        <p class="mb-2">
                            <strong>Patient:</strong>
                            Hendricks, Ayesha
                        </p>

                        <p class="mb-2">
                            <strong>Test:</strong>
                            PT / INR
                        </p>

                        <span class="status-badge badge-review">
                            To Be Reviewed
                        </span>

                        <span class="status-badge badge-resubmitted">
                            Resubmitted
                        </span>


                        <div class="note-box">

                            <strong>
                                Notes From Verifying Technician
                            </strong>

                            <p class="mb-0 mt-2">

                                INR result formatting was incorrect.
                                Please verify decimal placement before resubmitting.

                            </p>

                            <small class="text-muted">
                                Verified by Technician M. Jacobs
                            </small>

                        </div>


                        <!-- HISTORY -->
                        <div class="history">

                            <h5 class="mb-4">
                                Verification History
                            </h5>


                            <div class="history-item">

                                <div class="history-dot"></div>

                                <div class="history-title">
                                    Original Results Submitted
                                </div>

                                <div class="history-meta">
                                    Technician A. Smith
                                </div>

                            </div>


                            <div class="history-item">

                                <div class="history-dot"></div>

                                <div class="history-title">
                                    Verification Rejected
                                </div>

                                <div class="history-meta">
                                    Technician M. Jacobs
                                </div>

                                <p class="mb-0 mt-2">
                                    Decimal placement requires correction.
                                </p>

                            </div>


                            <div class="history-item">

                                <div class="history-dot"></div>

                                <div class="history-title">
                                    Results Recaptured
                                </div>

                                <div class="history-meta">
                                    Technician A. Smith
                                </div>

                                <p class="mb-0 mt-2">
                                    Result corrected and resubmitted for verification.
                                </p>

                            </div>


                            <div class="history-item">

                                <div class="history-dot"></div>

                                <div class="history-title">
                                    Resubmitted For Verification
                                </div>

                                <div class="history-meta">
                                    Current Status
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="text-end ms-4">

                        <p class="text-warning fw-bold">
                            Awaiting technician review
                        </p>

                        <a asp-controller="LabTechnician"
                           asp-action="CaptureResults"
                           class="btn-dark-custom mb-2">

                            <i class="fa-solid fa-rotate"></i>
                            Recapture Results

                        </a>

                        <br />

                        <a asp-controller="LabTechnician"
                           asp-action="TestDetail"
                           class="btn-outline-custom">

                            View Details

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>