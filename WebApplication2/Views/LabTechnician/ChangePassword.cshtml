@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Change Password";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>
    .page-container {
        max-width: 700px;
        margin: 50px auto;
    }

    .card-dark {
        background: #fff;
        border-radius: 20px;
        padding: 35px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
    }

    .change-password-page .form-control, .change-password-page .form-control:focus {
        background: #fff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .change-password-page .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 .15rem rgba(59,130,246,.15);
        }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: #fff !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: .2s ease;
        display: inline-block;
        cursor: pointer;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper .form-control {
            padding-right: 45px;
        }

    .toggle-password {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #6b7280;
        font-size: 1rem;
        user-select: none;
    }

        .toggle-password:hover {
            color: #1f2937;
        }

    .change-password-page .text-muted {
        color: #6b7280 !important;
    }

    .change-password-page label {
        margin-bottom: 6px;
        color: #374151;
        font-weight: 500;
    }

    .change-password-page h1 {
        color: #1f2937;
        font-weight: 700;
    }
</style>

<div class="page-container change-password-page">
    <div class="card-dark">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Change Password</h1>
                <p class="text-muted">Update your account password securely.</p>
            </div>
            <a asp-controller="LabTechnician" asp-action="Profile" class="btn-dark-custom">← Profile</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
        <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-controller="LabTechnician" asp-action="ChangePassword" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <div class="mb-4">
                <label for="CurrentPassword" class="form-label">Current Password</label>
                <div class="password-wrapper">
                    <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" required maxlength="128" />
                    <span class="toggle-password" role="button" tabindex="0" aria-label="Show or hide current password"
                          onclick="togglePassword('CurrentPassword', this)" onkeydown="togglePasswordOnKey(event, 'CurrentPassword', this)">
                        <i class="fa-solid fa-eye"></i>
                    </span>
                </div>
            </div>

            <div class="mb-4">
                <label for="NewPassword" class="form-label">New Password</label>
                <div class="password-wrapper">
                    <input type="password" id="NewPassword" name="NewPassword" class="form-control" autocomplete="new-password" required minlength="8" maxlength="128" />
                    <span class="toggle-password" role="button" tabindex="0" aria-label="Show or hide new password"
                          onclick="togglePassword('NewPassword', this)" onkeydown="togglePasswordOnKey(event, 'NewPassword', this)">
                        <i class="fa-solid fa-eye"></i>
                    </span>
                </div>
                <small class="text-muted">Use at least 8 characters. The server-side password policy will also be applied.</small>
            </div>

            <div class="mb-4">
                <label for="ConfirmPassword" class="form-label">Confirm New Password</label>
                <div class="password-wrapper">
                    <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" autocomplete="new-password" required minlength="8" maxlength="128" />
                    <span class="toggle-password" role="button" tabindex="0" aria-label="Show or hide password confirmation"
                          onclick="togglePassword('ConfirmPassword', this)" onkeydown="togglePasswordOnKey(event, 'ConfirmPassword', this)">
                        <i class="fa-solid fa-eye"></i>
                    </span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn-dark-custom me-2"><i class="fa-solid fa-key me-1"></i> Update Password</button>
                <button type="reset" class="btn-dark-custom">Clear</button>
            </div>
        </form>
    </div>
</div>

<script>
    function togglePassword(fieldId, element) {
        const field = document.getElementById(fieldId);
        const icon = element.querySelector("i");
        if (!field || !icon) return;

        if (field.type === "password") {
            field.type = "text";
            icon.classList.replace("fa-eye", "fa-eye-slash");
        } else {
            field.type = "password";
            icon.classList.replace("fa-eye-slash", "fa-eye");
        }
    }

    function togglePasswordOnKey(event, fieldId, element) {
        if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            togglePassword(fieldId, element);
        }
    }
</script>