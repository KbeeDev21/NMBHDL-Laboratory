@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "My Profile";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>

    .page-container {
        max-width: 900px;
        margin: 50px auto;
    }

    .profile-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 35px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .profile-row {
        background: #f8fafc;
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 15px;
        border: 1px solid #e2e8f0;
        transition: 0.2s ease;
    }

        .profile-row:hover {
            background: #f1f5f9;
        }

    .profile-label {
        color: #6b7280;
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .profile-value {
        font-size: 1.05rem;
        font-weight: 600;
        color: #1f2937;
    }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 20px;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    h1 {
        font-weight: 700;
        color: #1f2937;
    }

    .text-muted {
        color: #6b7280 !important;
    }

</style>

<div class="page-container">

    <div class="profile-card">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h1>My Profile</h1>

                <p class="text-muted">
                    View and manage technician account information.
                </p>

            </div>

            <a asp-controller="Home"
               asp-action="LabTechnicianDashboard"
               class="btn-dark-custom">

                ← Dashboard

            </a>

        </div>

        <!-- Profile Details -->
        <div class="profile-row">

            <div class="profile-label">
                Full Name
            </div>

            <div class="profile-value">
                Keenen James
            </div>

        </div>

        <div class="profile-row">

            <div class="profile-label">
                Employee Number
            </div>

            <div class="profile-value">
                LT-001
            </div>

        </div>

        <div class="profile-row">

            <div class="profile-label">
                Email Address
            </div>

            <div class="profile-value">
                james.keenen@nmbhlab.co.za
            </div>

        </div>

        <div class="profile-row">

            <div class="profile-label">
                Contact Number
            </div>

            <div class="profile-value">
                082 123 4567
            </div>

        </div>

        <div class="profile-row">

            <div class="profile-label">
                Role
            </div>

            <div class="profile-value">
                Laboratory Technician
            </div>

        </div>

        <!-- Actions -->
        <div class="mt-4">

            <a asp-controller="LabTechnician"
               asp-action="EditProfile"
               class="btn-dark-custom me-2">

                Edit Profile

            </a>

            <a asp-controller="LabTechnician"
               asp-action="ChangePassword"
               class="btn-dark-custom">

                Change Password

            </a>

        </div>

    </div>

</div>