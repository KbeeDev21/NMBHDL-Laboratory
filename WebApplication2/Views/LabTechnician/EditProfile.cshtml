@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Edit Profile";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>

    .page-container {
        max-width: 900px;
        margin: 50px auto;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 35px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .form-control,
    .form-control:focus {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 20px;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    label {
        margin-bottom: 6px;
        color: #374151;
        font-weight: 500;
    }

    h1 {
        color: #1f2937;
        font-weight: 700;
    }

    .text-muted {
        color: #6b7280 !important;
    }

</style>

<div class="page-container">

    <div class="card-dark">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h1>Edit Profile</h1>

                <p class="text-muted">
                    Update technician profile information.
                </p>

            </div>

            <a asp-controller="LabTechnician"
               asp-action="Profile"
               class="btn-dark-custom">

                ← Profile

            </a>

        </div>

        <!-- Form -->
        <div class="mb-3">

            <label class="form-label">
                Full Name
            </label>

            <input class="form-control"
                   value="Keenen James" />

        </div>

        <div class="mb-3">

            <label class="form-label">
                Email Address
            </label>

            <input class="form-control"
                   value="james.keenen@nmbhlab.co.za" />

        </div>

        <div class="mb-4">

            <label class="form-label">
                Contact Number
            </label>

            <input class="form-control"
                   value="082 123 4567" />

        </div>

        <!-- Actions -->
        <div>

            <button class="btn-dark-custom me-2">

                Save Changes

            </button>

            <a asp-controller="LabTechnician"
               asp-action="Profile"
               class="btn-dark-custom">

                Cancel

            </a>

        </div>

    </div>

</div>