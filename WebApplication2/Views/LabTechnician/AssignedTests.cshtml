                        <div class="info-section-title">

                            <i class="fa-solid fa-vial"></i>
                            Sample Information

                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <div class="sample-box">

                                    <div class="sample-label">
                                        Sample Type
                                    </div>

                                    <div class="sample-value">
                                        Serum
                                    </div>

                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="sample-box">

                                    <div class="sample-label">
                                        Sample Barcode
                                    </div>

                                    <div class="sample-value">
                                        BC-889214
                                    </div>

                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="sample-box">

                                    <div class="sample-label">
                                        Doctor
                                    </div>

                                    <div class="sample-value">
                                        Dr. M. Williams
                                    </div>

                                </div>

                            </div>

                            <div class="col-md-6">

                                <div class="sample-box">

                                    <div class="sample-label">
                                        Technician
                                    </div>

                                    <div class="sample-value">
                                        Keenen James
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- REQUEST INFORMATION -->
                    <div class="info-section">

                        <div class="info-section-title">

                            <i class="fa-solid fa-clipboard-list"></i>
                            Request Information

                        </div>

                        <div class="row g-3">

                            <div class="col-md-4">

                                <div class="sample-box">

                                    <div class="sample-label">
                                        Request Number
                                    </div>

                                    <div class="sample-value">
                                        REQ-2026-00125
                                    </div>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <div class="sample-box">

                                    <div class="sample-label">
                                        Date Started
                                    </div>

                                    <div class="sample-value">
                                        2026/08/20
                                    </div>

                                </div>

                            </div>

                            <div class="col-md-4">

                                <div class="sample-box">

                                    <div class="sample-label">
                                        Priority
                                    </div>

                                    <div class="sample-value">
                                        Routine
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="mt-3">

                            <div class="info-label">
                                Requested Tests
                            </div>

                            <div class="requested-test">

                                <i class="fa-solid fa-check"></i>
                                ESR

                            </div>

                        </div>

                    </div>


                    <!-- PATIENT INFORMATION -->
                    <div class="info-section">

                        <div class="info-section-title">

                            <i class="fa-solid fa-user"></i>
                            Patient Clinical Information

                        </div>

                        <div class="row">

                            <div class="col-md-4 info-item">

                                <div class="info-label">
                                    Conditions
                                </div>

                                <div class="info-value">
                                    No known conditions
