@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Assigned Tests";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>

    .page-container {
        padding: 0;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .queue-card {
        background: #f8fafc;
        border-radius: 16px;
        padding: 22px;
        margin-bottom: 20px;
        border-left: 4px solid #2563eb;
        border-top: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        transition: 0.2s ease;
    }

        .queue-card:hover {
            background: #f1f5f9;
        }

    .status-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        margin-right: 6px;
        margin-top: 5px;
        font-weight: 600;
    }

    .badge-stat {
        background: #f4a261;
        color: black;
    }

    .badge-routine {
        background: #d9e6f2;
        color: black;
    }

    .badge-progress {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .badge-overdue {
        background: #dc3545;
        color: white;
    }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .btn-outline-custom {
        background: white;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-outline-custom:hover {
            background: #eef5ff;
        }

    .text-muted {
        color: #6b7280 !important;
    }

    .filter-box,
    .form-control,
    .form-select {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #ffffff;
            color: #1f2937;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    h1,
    h4,
    p,
    strong {
        color: #1f2937;
    }
</style>


<!-- MAIN CONTENT -->
<div class="main-content">

    <div class="page-container">

        <div class="card-dark">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h1>
                        Assigned Tests
                    </h1>

                    <p class="text-muted">
                        Tests currently assigned to the technician.
                    </p>

                </div>

                <a asp-controller="Home"
                   asp-action="LabTechnicianDashboard"
                   class="btn-dark-custom">

                    ← Dashboard

                </a>

            </div>


            <!-- FILTERS -->
            <div class="row g-3 mb-4">

                <div class="col-md-4">

                    <input class="form-control filter-box"
                           placeholder="Search patient..." />

                </div>

                <div class="col-md-4">

                    <select class="form-select filter-box">

                        <option>All Statuses</option>
                        <option>In Progress</option>
                        <option>Near Due</option>

                    </select>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- ASSIGNED TEST 1 -->
            <!-- ===================================================== -->

            <div class="queue-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="flex-grow-1">

                        <h4>
                            REQ-2026-00124
                        </h4>

                        <p class="mb-2">

                            <strong>Patient:</strong>
                            Baloyi, Thabo

                        </p>

                        <p class="mb-2">

                            <strong>Test:</strong>
                            FBC + Differential

                        </p>

                        <p class="mb-2">

                            <strong>Started:</strong>
                            09:22 AM

                        </p>

                        <span class="status-badge badge-progress">
                            In Progress
                        </span>

                        <span class="status-badge badge-stat">
                            STAT
                        </span>

                    </div>


                    <!-- ACTIONS -->
                    <div class="text-end ms-4">

                        <p class="text-danger fw-bold">
                            45 minutes overdue
                        </p>

                        <a asp-controller="LabTechnician"
                           asp-action="TestDetail"
                           class="btn-outline-custom me-2">

                            <i class="fa-solid fa-eye"></i>
                            View Sample Information

                        </a>

                        <a asp-controller="LabTechnician"
                           asp-action="CaptureResults"
                           asp-route-requestNumber="REQ-2026-00124"
                           class="btn-dark-custom">

                            <i class="fa-solid fa-flask"></i>
                            Capture Results

                        </a>

                    </div>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- ASSIGNED TEST 2 -->
            <!-- ===================================================== -->

            <div class="queue-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="flex-grow-1">

                        <h4>
                            REQ-2026-00125
                        </h4>

                        <p class="mb-2">

                            <strong>Patient:</strong>
                            Jacobs, Lerato

                        </p>

                        <p class="mb-2">

                            <strong>Test:</strong>
                            ESR

                        </p>

                        <p class="mb-2">

                            <strong>Started:</strong>
                            10:05 AM

                        </p>

                        <span class="status-badge badge-progress">
                            In Progress
                        </span>

                    </div>


                    <!-- ACTIONS -->
                    <div class="text-end ms-4">

                        <p class="text-success fw-bold">
                            Within TAT
                        </p>

                        <a asp-controller="LabTechnician"
                           asp-action="TestDetail"
                           class="btn-outline-custom me-2">

                            <i class="fa-solid fa-eye"></i>
                            View Sample Information

                        </a>

                        <a asp-controller="LabTechnician"
                           asp-action="CaptureResults"
                           asp-route-requestNumber="REQ-2026-00125"
                           class="btn-dark-custom">

                            <i class="fa-solid fa-flask"></i>
                            Capture Results

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>