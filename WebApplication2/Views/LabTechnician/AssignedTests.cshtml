                                <div class="info-value">
                                    Penicillin
                                </div>

                            </div>

                            <div class="col-md-4 info-item">

                                <div class="info-label">
                                    Medication
                                </div>

                                <div class="info-value">
                                    Ferrous Sulphate
                                </div>

                            </div>

                        </div>

                        <div class="mt-3">

                            <div class="info-label">
                                Clinical Notes from Doctor
                            </div>

                            <div class="clinical-notes">

                                Patient presents with fatigue and suspected iron deficiency.
                                Please process FBC and differential as a priority.

                            </div>

                        </div>

                    </div>


                    <!-- ACTION -->
                    <div class="mt-3">

                        <a asp-controller="LabTechnician"
                           asp-action="CaptureResults"
                           asp-route-requestNumber="REQ-2026-00124"
                           class="btn-dark-custom">

                            <i class="fa-solid fa-flask"></i>
                            Capture Results

                        </a>

                    </div>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- ASSIGNED TEST 2 -->
            <!-- ===================================================== -->

            <div class="queue-card">

                <!-- ALWAYS VISIBLE SUMMARY -->
                <div class="d-flex justify-content-between align-items-start">

                    <div class="flex-grow-1">

                        <h4>
                            REQ-2026-00125
                        </h4>

                        <p class="mb-2">

                            <strong>Patient:</strong>
                            Jacobs, Lerato

                        </p>

                        <p class="mb-2">

                            <strong>Test:</strong>
