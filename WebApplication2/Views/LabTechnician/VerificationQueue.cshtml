@model IEnumerable<WebApplication2.Models.VerificationQueueItemViewModel>

    @{
    ViewData["Title"] = "Verification Queue";
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";

    var queue = Model ?? Enumerable.Empty<WebApplication2.Models.VerificationQueueItemViewModel>();
    var items = queue.ToList();
    }

    <link rel="stylesheet" href="~/css/dashboardstyles.css" asp-append-version="true" />

    <style>
        .verification-page {
            padding: 24px;
        }

        .verification-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 24px;
        }

            .verification-header h1 {
                margin: 0 0 6px;
            }

            .verification-header p {
                margin: 0;
                color: #6b7280;
            }

        .queue-summary {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .summary-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 16px 20px;
            min-width: 150px;
        }

            .summary-card span {
                display: block;
                color: #6b7280;
                font-size: 13px;
                margin-bottom: 6px;
            }

            .summary-card strong {
                font-size: 24px;
            }

        .queue-toolbar {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

            .queue-toolbar input,
            .queue-toolbar select {
                padding: 11px 12px;
                border: 1px solid #d1d5db;
                border-radius: 8px;
                background: #fff;
                min-width: 180px;
            }

            .queue-toolbar input {
                flex: 1;
            }

        .verification-list {
            display: grid;
            gap: 16px;
        }

        .verification-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
        }

        .verification-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            flex-wrap: wrap;
            padding: 20px;
        }

            .verification-card-header h3 {
                margin: 0 0 8px;
            }

        .verification-meta {
            display: flex;
            gap: 8px 16px;
            flex-wrap: wrap;
            color: #6b7280;
            font-size: 13px;
        }

        .verification-card-body {
            padding: 0 20px 20px;
        }

        .verification-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            margin-bottom: 18px;
        }

        .detail-item {
            background: #f9fafb;
            border-radius: 8px;
            padding: 12px;
        }

            .detail-item span {
                display: block;
                color: #6b7280;
                font-size: 12px;
                margin-bottom: 5px;
            }

            .detail-item strong {
                overflow-wrap: anywhere;
            }

        .status-pill {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            background: #fef3c7;
            color: #92400e;
            font-size: 12px;
            font-weight: 600;
        }

            .status-pill.abnormal {
                background: #fee2e2;
                color: #991b1b;
            }

            .status-pill.normal {
                background: #dcfce7;
                color: #166534;
            }

        .verification-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .verification-btn {
            display: inline-block;
            padding: 10px 15px;
            border-radius: 8px;
            background: #2563eb;
            color: #fff;
            text-decoration: none;
            font-weight: 600;
        }

            .verification-btn:hover {
                background: #1d4ed8;
                color: #fff;
            }

        .empty-queue {
            padding: 40px 20px;
            text-align: center;
            border: 1px dashed #d1d5db;
            border-radius: 12px;
            background: #fff;
        }

            .empty-queue h3 {
                margin-bottom: 8px;
            }

            .empty-queue p {
                color: #6b7280;
                margin: 0;
            }

        .verification-card[hidden] {
            display: none;
        }

        @@media (max-width: 600px) {
            .verification-page {
                padding: 14px;
            }

            .verification-card-header {
                padding: 16px;
            }

            .verification-card-body {
                padding: 0 16px 16px;
            }

            .queue-toolbar input,
            .queue-toolbar select {
                width: 100%;
            }
        }
    </style>

    <div class="verification-page">
        <div class="verification-header">
            <div>
                <h1>Verification Queue</h1>
                <p>Review completed individual test results before they proceed.</p>
            </div>
        </div>

        <div class="queue-summary">
            <div class="summary-card">
                <span>Awaiting verification</span>
                <strong>@items.Count</strong>
            </div>
            <div class="summary-card">
                <span>Abnormal results</span>
                <strong>@items.Count(x => x.IsAbnormal)</strong>
            </div>
            <div class="summary-card">
                <span>STAT results</span>
                <strong>@items.Count(x => string.Equals(x.Urgency, "STAT", StringComparison.OrdinalIgnoreCase))</strong>
            </div>
        </div>

        <div class="queue-toolbar">
            <input id="verificationSearch"
                   type="search"
                   placeholder="Search patient, registration number, barcode or test..."
                   aria-label="Search verification queue" />

            <select id="urgencyFilter" aria-label="Filter by urgency">
                <option value="">All urgency levels</option>
                <option value="stat">STAT</option>
                <option value="routine">Routine / other</option>
            </select>

            <select id="resultFilter" aria-label="Filter by result status">
                <option value="">All result statuses</option>
                <option value="abnormal">Abnormal</option>
                <option value="normal">Within normal range</option>
            </select>
        </div>

        @if (!items.Any())
    {
        <div class="empty-queue">
            <h3>No results awaiting verification</h3>
            <p>Completed tests will appear here when they are available for verification.</p>
        </div>
    }
    else
    {
        <div class="verification-list" id="verificationList">
            @foreach (var item in items)
            {
                var isStat = string.Equals(item.Urgency, "STAT", StringComparison.OrdinalIgnoreCase);
                var searchableText = $"{item.PatientName} {item.PatientNumber} {item.Barcode} {item.RequestNumber} {item.TestName}";

            <article class="verification-card"
                     data-search="@searchableText.ToLowerInvariant()"
                     data-urgency="@(isStat ? "stat" : "routine")"
                     data-result="@(item.IsAbnormal ? "abnormal" : "normal")">

                <div class="verification-card-header">
                    <div>
                        <h3>@item.TestName</h3>
                        <div class="verification-meta">
                            <span>Request: @item.RequestNumber</span>
                            <span>Barcode: @item.Barcode</span>
                            <span>Completed: @(item.CompletionDateTime?.ToString("dd MMM yyyy, HH:mm") ?? "Not recorded")</span>
                        </div>
                    </div>

                    <div>
                        @if (item.IsAbnormal)
                            {
                        <span class="status-pill abnormal">Abnormal result</span>
                            }
                            else
                            {
                        <span class="status-pill normal">Within normal range</span>
                            }

                        @if (isStat)
                            {
                        <span class="status-pill abnormal">STAT</span>
                            }
                    </div>
                </div>

                <div class="verification-card-body">
                    <div class="verification-details">
                        <div class="detail-item">
                            <span>Patient</span>
                            <strong>@item.PatientName</strong>
                        </div>

                        <div class="detail-item">
                            <span>Registration number</span>
                            <strong>@item.PatientNumber</strong>
                        </div>

                        <div class="detail-item">
                            <span>Result</span>
                            <strong>@item.Result @(string.IsNullOrWhiteSpace(item.Units) ? "" : item.Units)</strong>
                        </div>

                        <div class="detail-item">
                            <span>Reference range</span>
                            <strong>
                                @if (item.NormalRangeMin.HasValue || item.NormalRangeMax.HasValue)
                                    {
                                <text>@(item.NormalRangeMin?.ToString() ?? "—") – @(item.NormalRangeMax?.ToString() ?? "—") @(item.Units)</text>
                                    }
                                    else
                                    {
                                <text>Not configured</text>
                                    }
                            </strong>
                        </div>

                        <div class="detail-item">
                            <span>Result status</span>
                            <strong>@item.ResultStatus</strong>
                        </div>

                        <div class="detail-item">
                            <span>Captured by</span>
                            <strong>@item.CapturedBy</strong>
                        </div>
                    </div>

                    <div class="verification-actions">
                        <a class="verification-btn"
                           asp-controller="LabTechnician"
                           asp-action="VerifyResults"
                           asp-route-testResultId="@item.TestResultID">
                            Review result
                        </a>
                    </div>
                </div>
            </article>
            }
        </div>
    }
    </div>

    <script>
        (() => {
            const searchInput = document.getElementById("verificationSearch");
            const urgencyFilter = document.getElementById("urgencyFilter");
            const resultFilter = document.getElementById("resultFilter");
            const cards = Array.from(document.querySelectorAll(".verification-card"));

            function filterQueue() {
                const search = (searchInput?.value || "").trim().toLowerCase();
                const urgency = urgencyFilter?.value || "";
                const result = resultFilter?.value || "";

                cards.forEach(card => {
                    const matchesSearch = (card.dataset.search || "").includes(search);
                    const matchesUrgency = !urgency || card.dataset.urgency === urgency;
                    const matchesResult = !result || card.dataset.result === result;

                    card.hidden = !(matchesSearch && matchesUrgency && matchesResult);
                });
            }

            searchInput?.addEventListener("input", filterQueue);
            urgencyFilter?.addEventListener("change", filterQueue);
            resultFilter?.addEventListener("change", filterQueue);
        })();
    </script>
