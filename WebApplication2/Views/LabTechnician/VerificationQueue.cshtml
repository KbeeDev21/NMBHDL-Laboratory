@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Verification Queue";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>

    .page-container {
        padding: 0;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .queue-card {
        background: #f8fafc;
        border-radius: 16px;
        padding: 22px;
        margin-bottom: 18px;
        border-left: 4px solid #198754;
        border-top: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        transition: 0.2s ease;
    }

        .queue-card:hover {
            background: #f1f5f9;
        }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        margin-right: 6px;
        margin-top: 5px;
        font-weight: 600;
    }

    .badge-complete {
        background: #198754;
        color: white;
    }

    .badge-stat {
        background: #f4a261;
        color: black;
    }

    .badge-awaiting {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .badge-abnormal {
        background: #dc3545;
        color: white;
    }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s;
        display: inline-block;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .btn-outline-custom {
        background: white;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s;
        display: inline-block;
    }

        .btn-outline-custom:hover {
            background: #eef5ff;
        }

    .filter-box,
    .form-control,
    .form-select {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #ffffff;
            color: #1f2937;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    .text-muted {
        color: #6b7280 !important;
    }

    h1,
    h4,
    p,
    strong {
        color: #1f2937;
    }


    /* =========================================================
       EXPANDABLE SAMPLE INFORMATION
       ========================================================= */

    .details-panel {
        display: none;
        margin-top: 20px;
    }

    .info-section {
        margin-top: 15px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 12px;
    }

    .info-section-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 15px;
    }

    .sample-box {
        background: #f8fafc;
        border: 1px solid #dbe3ec;
        border-radius: 10px;
        padding: 12px 15px;
        height: 100%;
    }

    .sample-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .sample-value {
        font-weight: 600;
        color: #1f2937;
    }

    .sample-note {
        font-size: 0.75rem;
        color: #6b7280;
        margin-top: 4px;
    }

    .clinical-notes {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 12px;
        color: #1e3a8a;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .test-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

        .test-list li {
            background: #f8fafc;
            border: 1px solid #dbe3ec;
            border-radius: 10px;
            padding: 10px 13px;
            margin-bottom: 8px;
            color: #374151;
        }

            .test-list li:last-child {
                margin-bottom: 0;
            }

        .test-list i {
            color: #0d6efd;
            margin-right: 8px;
        }


    /* =========================================================
       QUEUE ACTION AREA
       ========================================================= */

    .queue-card > .d-flex > .text-end {
        width: 180px;
        min-width: 180px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }

    .queue-card > .d-flex > .text-end > p {
        font-size: 0.78rem;
        line-height: 1.3;
        margin-bottom: 10px;
        white-space: nowrap;
    }

    .queue-card > .d-flex > .text-end > .d-flex {
        width: 100%;
    }

    .verify-result-button,
    .view-more-button {
        width: 180px !important;
        min-width: 180px !important;
        height: 38px;

        box-sizing: border-box;

        display: flex !important;
        align-items: center;
        justify-content: center;
        gap: 7px;

        padding: 0 14px !important;

        border-radius: 10px;

        font-size: 0.82rem;
        font-weight: 600;

        line-height: 1;
        text-align: center;

        transition: all 0.18s ease;
    }

    .verify-result-button {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: #ffffff !important;
    }

        .verify-result-button:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
            color: #ffffff !important;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(13, 110, 253, 0.18);
        }

    .view-more-button {
        background: #ffffff;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
    }

        .view-more-button:hover {
            background: #eef5ff;
            border-color: #0d6efd;
            color: #0d6efd !important;
            transform: translateY(-1px);
        }

    .verify-result-button i,
    .view-more-button i {
        font-size: 0.78rem;
        flex-shrink: 0;
    }

    .queue-card h4 {
        font-size: 1.05rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .queue-card p {
        font-size: 0.86rem;
    }


    /* =========================================================
       RESPONSIVE ACTION AREA
       ========================================================= */

    @@media (max-width: 768px) {

        .queue-card > .d-flex {
            flex-direction: column;
        }

        .queue-card > .d-flex > .text-end {
            width: 100%;
            min-width: 100%;
            margin-left: 0 !important;
            margin-top: 18px;
        }

        .queue-card .verify-result-button,
        .queue-card .view-more-button {
            width: 100% !important;
            min-width: 100% !important;
        }

        .queue-card > .d-flex > .text-end > p {
            text-align: left;
            white-space: normal;
        }
    }

</style>


