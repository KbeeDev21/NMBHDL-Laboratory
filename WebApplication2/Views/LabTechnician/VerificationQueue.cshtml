@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Verification Queue";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>

    .page-container {
        padding: 0;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .queue-card {
        background: #f8fafc;
        border-radius: 16px;
        padding: 22px;
        margin-bottom: 18px;
        border-left: 4px solid #198754;
        border-top: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        transition: 0.2s ease;
    }

        .queue-card:hover {
            background: #f1f5f9;
            transform: translateX(4px);
        }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        margin-right: 6px;
        margin-top: 5px;
        font-weight: 600;
    }

    .badge-complete {
        background: #198754;
        color: white;
    }

    .badge-stat {
        background: #f4a261;
        color: black;
    }

    .badge-awaiting {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .badge-abnormal {
        background: #dc3545;
        color: white;
    }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s;
        display: inline-block;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .filter-box,
    .form-control,
    .form-select {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #ffffff;
            color: #1f2937;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    .text-muted {
        color: #6b7280 !important;
    }

    h1,
    h4,
    p,
    strong {
        color: #1f2937;
    }

    .patient-summary {
        margin-top: 18px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 12px;
    }

    .summary-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .summary-value {
        color: #1f2937;
        font-weight: 600;
    }

    .result-summary {
        margin-top: 18px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 12px;
    }

    .result-row {
        border-bottom: 1px solid #e2e8f0;
        padding: 13px 0;
    }

        .result-row:last-child {
            border-bottom: none;
        }

    .result-name {
        font-weight: 700;
        color: #1f2937;
    }

    .result-value {
        font-weight: 600;
        color: #374151;
    }

    .normal-range {
        font-size: 0.82rem;
        color: #64748b;
        margin-top: 3px;
    }

    .notes-button {
        background: #ffffff;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
        border-radius: 8px;
        padding: 6px 11px;
        text-decoration: none;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .notes-button:hover {
            background: #eff6ff;
        }

    .clinical-notes {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 12px;
        color: #1e3a8a;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .verification-note {
        margin-top: 15px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px;
        color: #475569;
        font-size: 0.85rem;
    }
</style>


<!-- MAIN CONTENT -->
<div class="main-content">

    <div class="page-container">

        <div class="card-dark">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h1>
                        Verification Queue
                    </h1>

                    <p class="text-muted">
                        Completed tests awaiting second technician verification.
                    </p>

                </div>

                <a asp-controller="Home"
                   asp-action="LabTechnicianDashboard"
                   class="btn-dark-custom">

                    ← Dashboard

                </a>

            </div>


            <!-- Filters -->
            <div class="row g-3 mb-4">

                <div class="col-md-3">

                    <input class="form-control filter-box"
                           placeholder="Search request number..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select filter-box">

                        <option>All Priorities</option>
                        <option>STAT</option>
                        <option>Routine</option>

                    </select>

                </div>

                <div class="col-md-3">

                    <select class="form-select filter-box">

                        <option>All Statuses</option>
                        <option>Awaiting Verification</option>
                        <option>Abnormal Results</option>

                    </select>

                </div>

            </div>


            <!-- QUEUE ITEM 1 -->
            <div class="queue-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="flex-grow-1">

                        <h4>
                            REQ-2026-00124
                        </h4>

                        <p class="mb-2">
                            <strong>Patient:</strong>
                            Baloyi, Thabo
                        </p>

                        <p class="mb-2">
                            <strong>Test:</strong>
                            Full Blood Count + Differential
                        </p>

                        <p class="mb-2">
                            <strong>Completed By:</strong>
                            Technician A. Smith
                        </p>

                        <span class="status-badge badge-complete">
                            Completed
                        </span>

                        <span class="status-badge badge-awaiting">
                            Awaiting Verification
                        </span>

                        <span class="status-badge badge-stat">
                            STAT
                        </span>

                        <span class="status-badge badge-abnormal">
                            Abnormal Result
                        </span>


                        <!-- PATIENT INFORMATION -->
                        <div class="patient-summary">

                            <div class="row g-3">

                                <div class="col-md-2">

                                    <div class="summary-label">
                                        Patient Age
                                    </div>

                                    <div class="summary-value">
                                        42 years
                                    </div>

                                </div>

                                <div class="col-md-2">

                                    <div class="summary-label">
                                        Conditions
                                    </div>

                                    <div class="summary-value">
                                        Hypertension
                                    </div>

                                </div>

                                <div class="col-md-2">

                                    <div class="summary-label">
                                        Allergies
                                    </div>

                                    <div class="summary-value">
                                        Penicillin
                                    </div>

                                </div>

                                <div class="col-md-2">

                                    <div class="summary-label">
                                        Medication
                                    </div>

                                    <div class="summary-value">
                                        Amlodipine
                                    </div>

                                </div>

                            </div>


                            <div class="mt-3">

                                <div class="summary-label">
                                    Clinical Notes from Doctor
                                </div>

                                <div class="clinical-notes">

                                    Rule out severe infection.

                                </div>

                            </div>

                        </div>


                        <!-- RESULT SUMMARY -->
                        <div class="result-summary">

                            <div class="summary-label mb-2">
                                Captured Results
                            </div>


                            <!-- Haemoglobin -->
                            <div class="result-row">

                                <div class="row align-items-center">

                                    <div class="col-md-3">

                                        <div class="result-name">
                                            Haemoglobin
                                        </div>

                                        <div class="result-value">
                                            8.7 g/dL
                                        </div>

                                    </div>

                                    <div class="col-md-4">

                                        <div class="normal-range">
                                            Normal Range: 12.0 – 16.0 g/dL
                                        </div>

                                    </div>

                                    <div class="col-md-5 text-end">

                                        <span class="status-badge badge-abnormal">
                                            Abnormal Low
                                        </span>

                                        <a asp-controller="LabTechnician"
                                           asp-action="VerifyResults"
                                           class="notes-button">

                                            <i class="fa-solid fa-note-sticky"></i>
                                            Notes

                                        </a>

                                    </div>

                                </div>

                            </div>


                            <!-- WCC -->
                            <div class="result-row">

                                <div class="row align-items-center">

                                    <div class="col-md-3">

                                        <div class="result-name">
                                            White Cell Count
                                        </div>

                                        <div class="result-value">
                                            14.2 x10⁹/L
                                        </div>

                                    </div>

                                    <div class="col-md-4">

                                        <div class="normal-range">
                                            Normal Range: 4.0 – 11.0 x10⁹/L
                                        </div>

                                    </div>

                                    <div class="col-md-5 text-end">

                                        <span class="status-badge badge-abnormal">
                                            Abnormal High
                                        </span>

                                        <a asp-controller="LabTechnician"
                                           asp-action="VerifyResults"
                                           class="notes-button">

                                            <i class="fa-solid fa-note-sticky"></i>
                                            Notes

                                        </a>

                                    </div>

                                </div>

                            </div>


                            <!-- Platelets -->
                            <div class="result-row">

                                <div class="row align-items-center">

                                    <div class="col-md-3">

                                        <div class="result-name">
                                            Platelets
                                        </div>

                                        <div class="result-value">
                                            455 x10⁹/L
                                        </div>

                                    </div>

                                    <div class="col-md-4">

                                        <div class="normal-range">
                                            Normal Range: 150 – 450 x10⁹/L
                                        </div>

                                    </div>

                                    <div class="col-md-5 text-end">

                                        <span class="status-badge badge-abnormal">
                                            Abnormal High
                                        </span>

                                        <a asp-controller="LabTechnician"
                                           asp-action="VerifyResults"
                                           class="notes-button">

                                            <i class="fa-solid fa-note-sticky"></i>
                                            Notes

                                        </a>

                                    </div>

                                </div>

                            </div>


                            <div class="verification-note">

                                <i class="fa-solid fa-circle-info me-2"></i>

                                Each <strong>Notes</strong> button represents the technician
                                notes captured for that individual test.

                            </div>

                        </div>

                    </div>


                    <!-- ACTIONS -->
                    <div class="text-end ms-4">

                        <p class="text-warning fw-bold">
                            Awaiting second technician review
                        </p>

                        <a asp-controller="LabTechnician"
                           asp-action="VerifyResults"
                           class="btn-dark-custom mb-2">

                            <i class="fa-solid fa-magnifying-glass"></i>
                            Verify Result

                        </a>

                        <br />

                        <a asp-controller="LabTechnician"
                           asp-action="TestDetail"
                           class="btn-dark-custom">

                            View Detail

                        </a>

                    </div>

                </div>

            </div>


            <!-- QUEUE ITEM 2 -->
            <div class="queue-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="flex-grow-1">

                        <h4>
                            REQ-2026-00131
                        </h4>

                        <p class="mb-2">
                            <strong>Patient:</strong>
                            Hendricks, Ayesha
                        </p>

                        <p class="mb-2">
                            <strong>Test:</strong>
                            PT / INR
                        </p>

                        <p class="mb-2">
                            <strong>Completed By:</strong>
                            Technician M. Jacobs
                        </p>

                        <span class="status-badge badge-complete">
                            Completed
                        </span>

                        <span class="status-badge badge-awaiting">
                            Awaiting Verification
                        </span>


                        <!-- PATIENT INFORMATION -->
                        <div class="patient-summary">

                            <div class="row g-3">

                                <div class="col-md-2">

                                    <div class="summary-label">
                                        Patient Age
                                    </div>

                                    <div class="summary-value">
                                        35 years
                                    </div>

                                </div>

                                <div class="col-md-2">

                                    <div class="summary-label">
                                        Conditions
                                    </div>

                                    <div class="summary-value">
                                        None reported
                                    </div>

                                </div>

                                <div class="col-md-2">

                                    <div class="summary-label">
                                        Allergies
                                    </div>

                                    <div class="summary-value">
                                        None reported
                                    </div>

                                </div>

                                <div class="col-md-2">

                                    <div class="summary-label">
                                        Medication
                                    </div>

                                    <div class="summary-value">
                                        Warfarin
                                    </div>

                                </div>

                            </div>


                            <div class="mt-3">

                                <div class="summary-label">
                                    Clinical Notes from Doctor
                                </div>

                                <div class="clinical-notes">

                                    Monitor coagulation levels.

                                </div>

                            </div>

                        </div>


                        <!-- RESULT SUMMARY -->
                        <div class="result-summary">

                            <div class="summary-label mb-2">
                                Captured Result
                            </div>

                            <div class="result-row">

                                <div class="row align-items-center">

                                    <div class="col-md-3">

                                        <div class="result-name">
                                            PT / INR
                                        </div>

                                        <div class="result-value">
                                            2.4
                                        </div>

                                    </div>

                                    <div class="col-md-4">

                                        <div class="normal-range">
                                            Normal Range: 0.8 – 1.2 INR
                                        </div>

                                    </div>

                                    <div class="col-md-5 text-end">

                                        <span class="status-badge badge-abnormal">
                                            Abnormal High
                                        </span>

                                        <a asp-controller="LabTechnician"
                                           asp-action="VerifyResults"
                                           class="notes-button">

                                            <i class="fa-solid fa-note-sticky"></i>
                                            Notes

                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ACTIONS -->
                    <div class="text-end ms-4">

                        <p class="text-success fw-bold">
                            Within verification window
                        </p>

                        <a asp-controller="LabTechnician"
                           asp-action="VerifyResults"
                           class="btn-dark-custom mb-2">

                            <i class="fa-solid fa-magnifying-glass"></i>
                            Verify Result

                        </a>

                        <br />

                        <a asp-controller="LabTechnician"
                           asp-action="TestDetail"
                           class="btn-dark-custom">

                            View Detail

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>