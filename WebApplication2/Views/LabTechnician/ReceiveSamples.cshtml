@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Receive Samples";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>
    .page-container {
        max-width: 1300px;
        margin: 0 auto;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .section-box {
        background: #f8fafc;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 22px;
        border: 1px solid #e2e8f0;
    }

    .form-control,
    .form-select {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #ffffff;
            color: #1f2937;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .status-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-received {
        background: #198754;
        color: white;
    }

    .text-muted {
        color: #6b7280 !important;
    }

    h1,
    h4,
    label,
    p,
    strong {
        color: #1f2937;
    }
</style>


<!-- MAIN CONTENT -->
<div class="main-content">

    <div class="page-container">

        <div class="card-dark">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h1>Receive Samples</h1>

                    <p class="text-muted">
                        Capture received patient samples and update request status.
                    </p>

                </div>

                <a asp-controller="Home"
                   asp-action="LabTechnicianDashboard"
                   class="btn-dark-custom">

                    ← Dashboard

                </a>

            </div>

            <!-- Sample Reception Form -->
            <div class="section-box">

                <h4 class="mb-4">
                    Sample Reception Information
                </h4>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="form-label">
                            Request Number
                        </label>

                        <input class="form-control"
                               value="REQ-2026-00124" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Sample Barcode Number
                        </label>

                        <input class="form-control"
                               value="BC-889213" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Sample Type
                        </label>

                        <select class="form-select">

                            <option>Whole Blood</option>
                            <option>Plasma</option>
                            <option>Serum</option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Technician Receiving Sample
                        </label>

                        <input class="form-control"
                               value="Keenen James" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Date Received
                        </label>

                        <input type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-6">

                        <label class="form-label">
                            Time Received
                        </label>

                        <input type="time"
                               class="form-control" />

                    </div>

                </div>

            </div>

            <!-- Request Summary -->
            <div class="section-box">

                <h4 class="mb-3">
                    Request Summary
                </h4>

                <p>
                    <strong>Patient:</strong>
                    Baloyi, Thabo
                </p>

                <p>
                    <strong>Doctor:</strong>
                    Dr. F. Abrahams
                </p>

                <p>
                    <strong>Requested Tests:</strong>
                    FBC + Differential, ESR
                </p>

                <p>
                    <strong>Priority:</strong>
                    STAT
                </p>

                <span class="status-badge badge-received">
                    Samples Received
                </span>

            </div>

            <!-- Actions -->
            <div class="mt-4">

                <a asp-controller="LabTechnician"
                   asp-action="AwaitingSelection"
                   class="btn-dark-custom me-2">

                    Save & Update Status

                </a>

                <button class="btn-dark-custom me-2">

                    Print Barcode Label

                </button>

                <a asp-controller="LabTechnician"
                   asp-action="TestDetail"
                   class="btn-dark-custom">

                    View Request Detail

                </a>

            </div>

        </div>

    </div>

</div>