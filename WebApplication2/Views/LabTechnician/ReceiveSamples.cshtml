@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Receive Samples";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>
    .page-container {
        max-width: 1300px;
        margin: 0 auto;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .table-container {
        background: #f8fafc;
        border-radius: 16px;
        padding: 20px;
        border: 1px solid #e2e8f0;
        overflow-x: auto;
    }

    .sample-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .sample-table th {
            background: #0d6efd;
            color: white;
            padding: 14px 16px;
            text-align: left;
            font-size: 0.9rem;
            font-weight: 600;
            white-space: nowrap;
        }

            .sample-table th:first-child {
                border-radius: 10px 0 0 0;
            }

            .sample-table th:last-child {
                border-radius: 0 10px 0 0;
            }

        .sample-table td {
            padding: 16px;
            border-bottom: 1px solid #e2e8f0;
            color: #1f2937;
            vertical-align: middle;
            background: white;
        }

        .sample-table tbody tr:hover td {
            background: #f8fafc;
        }

        .sample-table tbody tr:last-child td {
            border-bottom: none;
        }

    .priority-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .priority-stat {
        background: #fee2e2;
        color: #b91c1c;
    }

    .priority-urgent {
        background: #fef3c7;
        color: #92400e;
    }

    .priority-routine {
        background: #dcfce7;
        color: #166534;
    }

    .sample-type {
        color: #4b5563;
    }

    .btn-select {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 10px;
        padding: 8px 16px;
        text-decoration: none;
        display: inline-block;
        font-size: 0.9rem;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-select:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
            color: white;
        }

    .btn-dashboard {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
    }

        .btn-dashboard:hover {
            background: #0b5ed7;
        }

    .empty-message {
        text-align: center;
        padding: 40px 20px;
        color: #6b7280;
    }

    h1,
    h4,
    p {
        color: #1f2937;
    }

    .text-muted {
        color: #6b7280 !important;
    }

    .sample-count {
        display: inline-block;
        background: #e8f1ff;
        color: #0d6efd;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 15px;
    }
</style>

<div class="main-content">

    <div class="page-container">

        <div class="card-dark">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h1>Receive Samples</h1>

                    <p class="text-muted mb-0">
                        Select a patient sample waiting to be accepted.
                    </p>
                </div>

                <a asp-controller="Home"
                   asp-action="LabTechnicianDashboard"
                   class="btn-dashboard">
                    ← Dashboard
                </a>

            </div>

            <!-- Samples Waiting -->
            <div>

                <h4 class="mb-2">
                    Samples Waiting to be Accepted
                </h4>

                <span class="sample-count">
                    <i class="fa-solid fa-vials me-1"></i>
                    4 Samples Waiting
                </span>

                <div class="table-container">

                    <table class="sample-table">

                        <thead>
                            <tr>
                                <th>Request Number</th>
                                <th>Patient</th>
                                <th>Sample Type</th>
                                <th>Doctor</th>
                                <th>Priority</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <!-- Sample 1 -->
                            <tr>
                                <td>
                                    <strong>REQ-2026-00124</strong>
                                </td>

                                <td>
                                    Baloyi, Thabo
                                </td>

                                <td class="sample-type">
                                    Whole Blood
                                </td>

                                <td>
                                    Dr. F. Abrahams
                                </td>

                                <td>
                                    <span class="priority-badge priority-stat">
                                        STAT
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="LabTechnician"
                                       asp-action="TestDetail"
                                       class="btn-select">
                                        Select Sample
                                    </a>
                                </td>
                            </tr>

                            <!-- Sample 2 -->
                            <tr>
                                <td>
                                    <strong>REQ-2026-00125</strong>
                                </td>

                                <td>
                                    Mbeki, Sarah
                                </td>

                                <td class="sample-type">
                                    Serum
                                </td>

                                <td>
                                    Dr. M. Williams
                                </td>

                                <td>
                                    <span class="priority-badge priority-urgent">
                                        Urgent
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="LabTechnician"
                                       asp-action="TestDetail"
                                       class="btn-select">
                                        Select Sample
                                    </a>
                                </td>
                            </tr>

                            <!-- Sample 3 -->
                            <tr>
                                <td>
                                    <strong>REQ-2026-00126</strong>
                                </td>

                                <td>
                                    Jacobs, Daniel
                                </td>

                                <td class="sample-type">
                                    Plasma
                                </td>

                                <td>
                                    Dr. T. Adams
                                </td>

                                <td>
                                    <span class="priority-badge priority-routine">
                                        Routine
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="LabTechnician"
                                       asp-action="TestDetail"
                                       class="btn-select">
                                        Select Sample
                                    </a>
                                </td>
                            </tr>

                            <!-- Sample 4 -->
                            <tr>
                                <td>
                                    <strong>REQ-2026-00127</strong>
                                </td>

                                <td>
                                    Williams, Lerato
                                </td>

                                <td class="sample-type">
                                    Whole Blood
                                </td>

                                <td>
                                    Dr. N. Petersen
                                </td>

                                <td>
                                    <span class="priority-badge priority-routine">
                                        Routine
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="LabTechnician"
                                       asp-action="TestDetail"
                                       class="btn-select">
                                        Select Sample
                                    </a>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>