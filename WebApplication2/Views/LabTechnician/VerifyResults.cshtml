
@model WebApplication2.Models.VerificationQueueItemViewModel

@{
    ViewData["Title"] = "Verify Test Result";
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";

    var hasRange = Model.NormalRangeMin.HasValue || Model.NormalRangeMax.HasValue;
}

<link rel="stylesheet" href="~/css/dashboardstyles.css" asp-append-version="true" />

<style>
    .verify-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px;
    }

    .verify-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

        .verify-header h1 {
            margin: 0 0 6px;
        }

        .verify-header p {
            color: #6b7280;
            margin: 0;
        }

    .back-link {
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
    }

    .verify-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 20px;
    }

        .verify-card h2 {
            margin: 0 0 18px;
            font-size: 19px;
        }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 14px;
    }

    .detail {
        padding: 14px;
        background: #f9fafb;
        border-radius: 8px;
        min-width: 0;
    }

        .detail span {
            display: block;
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 6px;
        }

        .detail strong {
            display: block;
            overflow-wrap: anywhere;
        }

    .result-panel {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 22px;
    }

    .result-value {
        font-size: 32px;
        font-weight: 700;
        margin: 8px 0;
        overflow-wrap: anywhere;
    }

    .status-pill {
        display: inline-block;
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 600;
        background: #dcfce7;
        color: #166534;
    }

        .status-pill.abnormal {
            background: #fee2e2;
            color: #991b1b;
        }

    .reference-text {
        color: #6b7280;
        margin-top: 8px;
    }

    .notice {
        border-radius: 8px;
        padding: 14px;
        background: #eff6ff;
        color: #1e40af;
        margin-top: 18px;
    }

    .verify-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .decision-buttons {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .decision-button {
        display: inline-block;
        padding: 11px 16px;
        border: 0;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        color: #fff;
        cursor: pointer;
    }

    .approve-button {
        background: #15803d;
    }

        .approve-button:hover {
            background: #166534;
        }

    .return-button {
        background: #b91c1c;
    }

        .return-button:hover {
            background: #991b1b;
        }

    .reason-label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .reason-input {
        display: block;
        width: 100%;
        box-sizing: border-box;
        min-height: 110px;
        padding: 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        font: inherit;
        resize: vertical;
    }

    .reason-help {
        color: #6b7280;
        font-size: 13px;
        margin-top: 6px;
    }

    .validation-message {
        color: #b91c1c;
        margin-top: 8px;
        display: none;
    }

    @@media (max-width: 600px) {
        .verify-page {
            padding: 14px;
        }

        .verify-card {
            padding: 16px;
        }

        .decision-buttons {
            width: 100%;
        }

        .decision-button {
            flex: 1;
            text-align: center;
        }
    }
</style>

<div class="verify-page">
    <div class="verify-header">
        <div>
            <h1>Verify Test Result</h1>
            <p>Review one completed test result at a time.</p>
        </div>

        <a class="back-link"
           asp-controller="LabTechnician"
           asp-action="VerificationQueue">
            &larr; Back to Verification Queue
        </a>
    </div>

    <section class="verify-card">
        <h2>Patient and Request Details</h2>

        <div class="details-grid">
            <div class="detail">
                <span>Patient name</span>
                <strong>@Model.PatientName</strong>
            </div>

            <div class="detail">
                <span>Registration number</span>
                <strong>@Model.PatientNumber</strong>
            </div>

            <div class="detail">
                <span>Request number</span>
                <strong>@Model.RequestNumber</strong>
            </div>

            <div class="detail">
                <span>Sample barcode</span>
                <strong>@Model.Barcode</strong>
            </div>

            <div class="detail">
                <span>Urgency</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.Urgency)
                        ? "Not specified"
                        : Model.Urgency)
                </strong>
            </div>

            <div class="detail">
                <span>Test completed</span>
                <strong>
                    @(Model.CompletionDateTime?.ToString("dd MMM yyyy, HH:mm")
                        ?? "Not recorded")
                </strong>
            </div>
        </div>
    </section>

    <section class="verify-card">
        <h2>Result Details</h2>

        <div class="result-panel">
            <div>
                <span>Test</span>
                <strong>@Model.TestName</strong>
            </div>

            <div class="result-value">
                @Model.Result
                @if (!string.IsNullOrWhiteSpace(Model.Units))
                {
                <span style="font-size: 16px; font-weight: 400;">
                    @Model.Units
                </span>
                }
            </div>

            @if (Model.IsAbnormal)
            {
            <span class="status-pill abnormal">Abnormal result</span>
            }
            else
            {
            <span class="status-pill">Within normal range</span>
            }

            <p class="reference-text">
                Reference range:
                @if (hasRange)
                {
                <strong>
                    @(Model.NormalRangeMin?.ToString() ?? "—")
                    –
                    @(Model.NormalRangeMax?.ToString() ?? "—")
                    @Model.Units
                </strong>
                }
                else
                {
                <strong>Not configured</strong>
                }
            </p>

            <p>
                <strong>Calculated result status:</strong>
                @Model.ResultStatus
            </p>

            <p>
                <strong>Captured by:</strong>
                @Model.CapturedBy
            </p>
        </div>

        <div class="notice">
            Review the result against the patient's details and the configured
            reference range before making a verification decision.
        </div>
    </section>

    <section class="verify-card">
        <h2>Verification Decision</h2>

        <p>
            Approve the result if it is acceptable. If it needs to be repeated,
            return it for recapture and provide a reason.
        </p>

        <form asp-controller="LabTechnician"
              asp-action="SubmitVerificationDecision"
              method="post"
              id="verificationForm">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="testResultId"
                   value="@Model.TestResultID" />

            <div style="margin: 20px 0;">
                <label for="returnReason" class="reason-label">
                    Reason for recapture
                </label>

                <textarea id="returnReason"
                          name="returnReason"
                          class="reason-input"
                          maxlength="1000"
                          placeholder="Explain why this result needs to be recaptured..."></textarea>

                <p class="reason-help">
                    Required when selecting Return for Recapture.
                </p>

                <p id="reasonError"
                   class="validation-message"
                   role="alert">
                    Please provide a reason before returning this result.
                </p>
            </div>

            <div class="verify-actions">
                <a class="back-link"
                   asp-controller="LabTechnician"
                   asp-action="VerificationQueue">
                    Cancel and return to queue
                </a>

                <div class="decision-buttons">
                    <button type="submit"
                            name="decision"
                            value="Returned"
                            class="decision-button return-button"
                            onclick="return validateReturn();">
                        Return for Recapture
                    </button>

                    <button type="submit"
                            name="decision"
                            value="Approved"
                            class="decision-button approve-button">
                        Approve Result
                    </button>
                </div>
            </div>
        </form>
    </section>

    <p style="color: #6b7280; font-size: 13px;">
        Result ID: @Model.TestResultID
    </p>
</div>

<script>
    function validateReturn() {
        const reason = document.getElementById("returnReason").value.trim();
        const error = document.getElementById("reasonError");

        if (!reason) {
            error.style.display = "block";
            document.getElementById("returnReason").focus();
            return false;
        }

        error.style.display = "none";

        return confirm("Return this test result for recapture?");
    }

    document.getElementById("returnReason").addEventListener("input", function () {
        if (this.value.trim()) {
            document.getElementById("reasonError").style.display = "none";
        }
    });

    document.getElementById("verificationForm").addEventListener("submit", function (event) {
        const submitter = event.submitter;

        if (submitter && submitter.value === "Returned") {
            if (!document.getElementById("returnReason").value.trim()) {
                event.preventDefault();
                document.getElementById("reasonError").style.display = "block";
            }
        }
    });
</script>
