@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Verify Results";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>

    .page-container {
        max-width: 1200px;
        margin: 40px auto;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 18px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .result-card {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
        border-left: 4px solid #2563eb;
        border-top: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        margin-right: 5px;
        font-weight: 600;
    }

    .badge-awaiting {
        background: #2563eb;
        color: white;
    }

    .badge-abnormal {
        background: #dc3545;
        color: white;
    }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 20px;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .form-control,
    .form-select {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #ffffff;
            color: #1f2937;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    h1,
    h4,
    p,
    strong,
    label {
        color: #1f2937;
    }

    .text-muted {
        color: #6b7280 !important;
    }

</style>

<div class="page-container">
    <div class="card-dark">
        <a asp-controller="LabTechnician"
           asp-action="Dashboard"
           class="text-info text-decoration-none">
            ← Back to Dashboard
        </a>

        <h1 class="mt-3">Verify Results</h1>
        <p class="text-muted">
            Review completed test results and approve or return them for correction.
        </p>

        <!-- Result Card -->
        <div class="result-card">
            <h4>Hendricks, Ayesha — Full Blood Count</h4>

            <p>
                <span class="status-badge badge-awaiting">Awaiting Verification</span>
                <span class="status-badge badge-abnormal">Abnormal Result</span>
            </p>

            <p><strong>Haemoglobin:</strong> 8.7 g/dL</p>
            <p><strong>White Cell Count:</strong> 14.2 x10⁹/L</p>
            <p><strong>Platelets:</strong> 455 x10⁹/L</p>

            <div class="mb-3">
                <label class="form-label">Verification Decision</label>
                <select class="form-select">
                    <option>Verified</option>
                    <option>To Be Reviewed</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Review Notes</label>
                <textarea class="form-control" rows="4"
                          placeholder="Enter any comments or concerns..."></textarea>
            </div>

            <button class="btn-dark-custom me-2">
                Submit Verification
            </button>

            <a asp-controller="LabTechnician"
               asp-action="TestDetail"
               class="btn-dark-custom">
                View Full Details
            </a>
        </div>
    </div>
</div>