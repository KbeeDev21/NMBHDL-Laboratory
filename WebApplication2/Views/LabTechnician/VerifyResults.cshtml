@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Verify Results";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>

    .page-container {
        max-width: 1200px;
        margin: 40px auto;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 18px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .section-card {
        background: #f8fafc;
        border-radius: 14px;
        padding: 22px;
        margin-top: 20px;
        border: 1px solid #e2e8f0;
    }

    .result-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 15px;
        border: 1px solid #dbe3ec;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        margin-right: 5px;
        font-weight: 600;
    }

    .badge-awaiting {
        background: #2563eb;
        color: white;
    }

    .badge-abnormal {
        background: #dc3545;
        color: white;
    }

    .badge-normal {
        background: #198754;
        color: white;
    }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 20px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .btn-outline-custom {
        background: white;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
        border-radius: 10px;
        padding: 8px 14px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-outline-custom:hover {
            background: #eff6ff;
        }

    .notes-button {
        background: white;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
    }

        .notes-button:hover {
            background: #eff6ff;
        }

    .form-control,
    .form-select {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #ffffff;
            color: #1f2937;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    h1,
    h4,
    h5,
    p,
    strong,
    label {
        color: #1f2937;
    }

    .text-muted {
        color: #6b7280 !important;
    }

    .info-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .info-value {
        color: #1f2937;
        font-weight: 600;
    }

    .clinical-notes {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 13px;
        color: #1e3a8a;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .normal-range {
        background: #f1f5f9;
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 0.82rem;
        color: #475569;
        margin-top: 8px;
    }

    .technician-note {
        display: none;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 13px;
        margin-top: 12px;
        color: #1e3a8a;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .test-header {
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 12px;
        margin-bottom: 15px;
    }
</style>


<div class="page-container">

    <div class="card-dark">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-start">

            <div>

                <a asp-controller="LabTechnician"
                   asp-action="VerificationQueue"
                   class="text-decoration-none">

                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Verification Queue

                </a>

                <h1 class="mt-3">
                    Verify Results
                </h1>

                <p class="text-muted">
                    Review all information captured by the laboratory technician
                    before approving or returning the results.
                </p>

            </div>

            <div>

                <span class="status-badge badge-awaiting">
                    Awaiting Verification
                </span>

                <span class="status-badge badge-abnormal">
                    Abnormal Result
                </span>

            </div>

        </div>


        <!-- REQUEST / PATIENT INFORMATION -->
        <div class="section-card">

            <h4 class="mb-4">
                Patient & Request Information
            </h4>

            <div class="row g-4">

                <div class="col-md-3">

                    <div class="info-label">
                        Request Number
                    </div>

                    <div class="info-value">
                        REQ-2026-00124
                    </div>

                </div>

                <div class="col-md-3">

                    <div class="info-label">
                        Patient
                    </div>

                    <div class="info-value">
                        Baloyi, Thabo
                    </div>

                </div>

                <div class="col-md-2">

                    <div class="info-label">
                        Patient Age
                    </div>

                    <div class="info-value">
                        42 years
                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-label">
                        Test Request
                    </div>

                    <div class="info-value">
                        Full Blood Count + Differential
                    </div>

                </div>

            </div>

        </div>


        <!-- CLINICAL INFORMATION -->
        <div class="section-card">

            <h4 class="mb-4">
                Clinical Information
            </h4>

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="info-label">
                        Conditions
                    </div>

                    <div class="info-value">
                        Hypertension
                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-label">
                        Allergies
                    </div>

                    <div class="info-value">
                        Penicillin
                    </div>

                </div>

                <div class="col-md-4">

                    <div class="info-label">
                        Medication
                    </div>

                    <div class="info-value">
                        Amlodipine
                    </div>

                </div>

            </div>

            <div class="mt-4">

                <div class="info-label">
                    Clinical Notes from Doctor
                </div>

                <div class="clinical-notes">

                    Rule out severe infection.

                </div>

            </div>

        </div>


        <!-- RESULTS -->
        <div class="section-card">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h4 class="mb-1">
                        Captured Test Results
                    </h4>

                    <p class="text-muted mb-0">
                        Review the original results, normal ranges and technician notes.
                    </p>

                </div>

            </div>


            <!-- HAEMOGLOBIN -->
            <div class="result-card">

                <div class="test-header d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="mb-1">
                            Haemoglobin
                        </h5>

                        <span class="status-badge badge-abnormal">
                            Abnormal Low
                        </span>

                    </div>

                    <button type="button"
                            class="notes-button"
                            onclick="toggleNotes('haemoglobinNotes')">

                        <i class="fa-solid fa-note-sticky"></i>
                        Notes

                    </button>

                </div>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="info-label">
                            Original Result
                        </div>

                        <div class="info-value">
                            8.7 g/dL
                        </div>

                    </div>

                    <div class="col-md-8">

                        <div class="normal-range">

                            <strong>Normal Range:</strong>
                            12.0 – 16.0 g/dL

                        </div>

                    </div>

                </div>


                <div id="haemoglobinNotes"
                     class="technician-note">

                    <strong>
                        Technician Notes — Haemoglobin
                    </strong>

                    <p class="mb-0 mt-2">

                        Haemoglobin result is below the expected range.
                        Sample was processed without issues.

                    </p>

                </div>

            </div>


            <!-- WHITE CELL COUNT -->
            <div class="result-card">

                <div class="test-header d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="mb-1">
                            White Cell Count (WCC)
                        </h5>

                        <span class="status-badge badge-abnormal">
                            Abnormal High
                        </span>

                    </div>

                    <button type="button"
                            class="notes-button"
                            onclick="toggleNotes('wccNotes')">

                        <i class="fa-solid fa-note-sticky"></i>
                        Notes

                    </button>

                </div>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="info-label">
                            Original Result
                        </div>

                        <div class="info-value">
                            14.2 x10⁹/L
                        </div>

                    </div>

                    <div class="col-md-8">

                        <div class="normal-range">

                            <strong>Normal Range:</strong>
                            4.0 – 11.0 x10⁹/L

                        </div>

                    </div>

                </div>


                <div id="wccNotes"
                     class="technician-note">

                    <strong>
                        Technician Notes — White Cell Count
                    </strong>

                    <p class="mb-0 mt-2">

                        Elevated white cell count observed.
                        Result checked against the analyser output.

                    </p>

                </div>

            </div>


            <!-- PLATELETS -->
            <div class="result-card">

                <div class="test-header d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="mb-1">
                            Platelets
                        </h5>

                        <span class="status-badge badge-abnormal">
                            Abnormal High
                        </span>

                    </div>

                    <button type="button"
                            class="notes-button"
                            onclick="toggleNotes('plateletNotes')">

                        <i class="fa-solid fa-note-sticky"></i>
                        Notes

                    </button>

                </div>

                <div class="row g-3">

                    <div class="col-md-4">

                        <div class="info-label">
                            Original Result
                        </div>

                        <div class="info-value">
                            455 x10⁹/L
                        </div>

                    </div>

                    <div class="col-md-8">

                        <div class="normal-range">

                            <strong>Normal Range:</strong>
                            150 – 450 x10⁹/L

                        </div>

                    </div>

                </div>


                <div id="plateletNotes"
                     class="technician-note">

                    <strong>
                        Technician Notes — Platelets
                    </strong>

                    <p class="mb-0 mt-2">

                        Platelet count is slightly above the expected range.
                        Sample integrity was acceptable.

                    </p>

                </div>

            </div>

        </div>


        <!-- VERIFICATION DECISION -->
        <div class="section-card">

            <h4 class="mb-4">
                Verification Decision
            </h4>

            <div class="mb-3">

                <label class="form-label">
                    Verification Decision
                </label>

                <select class="form-select">

                    <option>Verified</option>
                    <option>Reject / Return for Review</option>

                </select>

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Verification Notes
                </label>

                <textarea class="form-control"
                          rows="4"
                          placeholder="Enter notes explaining the verification decision..."></textarea>

            </div>

        </div>


        <!-- ACTIONS -->
        <div class="mt-4">

            <button class="btn-dark-custom me-2">

                <i class="fa-solid fa-check"></i>
                Submit Verification

            </button>

            <a asp-controller="LabTechnician"
               asp-action="VerificationQueue"
               class="btn-outline-custom">

                Cancel

            </a>

        </div>

    </div>

</div>


<script>

    function toggleNotes(noteId) {

        const notes = document.getElementById(noteId);

        if (notes.style.display === "block") {

            notes.style.display = "none";

        } else {

            notes.style.display = "block";

        }

    }

</script>