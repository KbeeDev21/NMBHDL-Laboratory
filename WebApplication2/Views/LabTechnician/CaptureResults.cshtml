@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Capture Results";
}

@model WebApplication2.Models.CaptureResultsViewModel

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>

    .page-container {
        padding: 0;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .section-title {
        margin-bottom: 20px;
        font-weight: 700;
        color: #1f2937;
    }

    .info-box {
        background: #f8fafc;
        border-radius: 16px;
        padding: 22px;
        margin-bottom: 20px;
        border: 1px solid #e2e8f0;
    }

    .form-control,
    .form-select {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #ffffff;
            color: #1f2937;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    textarea.form-control {
        resize: vertical;
    }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .btn-outline-custom {
        background: white;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-outline-custom:hover {
            background: #eef5ff;
        }

    .abnormal {
        color: #dc3545;
        font-weight: bold;
    }

    .status-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        margin-right: 6px;
        margin-top: 5px;
        font-weight: 600;
    }

    .badge-stat {
        background: #f4a261;
        color: black;
    }

    .badge-processing {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .text-muted {
        color: #6b7280 !important;
    }

    h1,
    h4,
    p,
    strong,
    label {
        color: #1f2937;
    }

    label {
        margin-bottom: 6px;
    }

    .patient-age-box {
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 12px;
        padding: 14px 16px;
    }

    .patient-age-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #64748b;
        margin-bottom: 4px;
    }

    .patient-age-value {
        font-size: 1rem;
        font-weight: 600;
        color: #1f2937;
    }

    .result-card {
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 14px;
        padding: 20px;
        height: 100%;
    }

    .result-card-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 15px;
    }

    .normal-range {
        background: #f1f5f9;
        border-radius: 8px;
        padding: 9px 12px;
        margin-top: 8px;
        font-size: 0.82rem;
        color: #475569;
    }

        .normal-range strong {
            color: #334155;
        }

    .technician-note {
        margin-top: 15px;
    }

        .technician-note label {
            font-size: 0.85rem;
            font-weight: 600;
        }

    .assigned-test {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
        border-radius: 10px;
        padding: 12px 15px;
        margin-top: 15px;
    }

    .locked-test {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 15px;
        color: #64748b;
        font-size: 0.85rem;
    }

    .normal {
        color: #198754;
        font-weight: bold;
    }

    .abnormal {
        color: #dc3545;
        font-weight: bold;
    }

    .status-neutral {
        color: #64748b;
        font-weight: 600;
    }

</style>


<!-- MAIN CONTENT -->
<div class="main-content">

    <div class="page-container">

        <div class="card-dark">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h1>
                        Capture Results
                    </h1>

                    <p class="text-muted">
                        Record the assigned laboratory test results and technician notes.
                    </p>

                </div>

                <a asp-controller="Home"
                   asp-action="LabTechnicianDashboard"
                   class="btn-outline-custom">

                    <i class="fa-solid fa-arrow-left"></i>
                    Dashboard

                </a>

            </div>


            <!-- Test Information -->
            <div class="info-box">

                <h4>
                    REQ-2026-00124
                </h4>

                <div class="row g-3 mt-1">

                    <div class="col-md-4">

                        <div class="patient-age-box">

                            <p class="mb-1">
                                <strong>Patient:</strong>
                            </p>

                            <p>
                                Baloyi, Thabo
                            </p>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="patient-age-box">

                            <p class="mb-1">
                                <strong>Test Request:</strong>
                            </p>

                            <p>
                                Full Blood Count + Differential
                            </p>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="patient-age-box">

                            <div class="patient-age-label">
                                Patient Age
                            </div>

                            <div class="patient-age-value">
                                42 years
                            </div>

                        </div>

                    </div>

                </div>

                <span class="status-badge badge-processing">
                    In Progress
                </span>

                <span class="status-badge badge-stat">
                    STAT
                </span>

                <div class="assigned-test">

                    <i class="fa-solid fa-flask me-2"></i>

                    <strong>Assigned Test Type:</strong>
                    Haematology / Full Blood Count

                    <div class="mt-1">
                        This technician may capture results only for the test type assigned to them.
                    </div>

                </div>

            </div>


            <!-- Clinical Information -->
            <div class="info-box">

                <h4 class="section-title">
                    Clinical Information
                </h4>

                <div class="row g-3">

                    <div class="col-md-4">

                        <strong>Medical Conditions</strong>

                        <p class="mt-1">
                            Hypertension
                        </p>

                    </div>

                    <div class="col-md-4">

                        <strong>Allergies</strong>

                        <p class="mt-1">
                            Penicillin
                        </p>

                    </div>

                    <div class="col-md-4">

                        <strong>Medication</strong>

                        <p class="mt-1">
                            Amlodipine
                        </p>

                    </div>

                </div>

                <div class="mt-3">

                    <strong>Clinical Notes from Doctor</strong>

                    <p class="mt-1">
                        Rule out severe infection.
                    </p>

                </div>

            </div>


          <!-- Result Entry -->
<div class="info-box">

    <h4 class="section-title">
        Result Values
    </h4>

    <p class="text-muted mb-4">
        Enter the result for each assigned test. The result status will be evaluated automatically against the normal range.
    </p>

    <div class="row g-3">

        <!-- HAEMOGLOBIN -->
        <div class="col-md-4">

            <div class="result-card">

                <div class="result-card-title">
                    Haemoglobin
                </div>

                <label class="form-label">
                    Result
                </label>

                <input type="number"
                       step="0.1"
                       class="form-control result-input"
                       asp-for="Haemoglobin"
                       placeholder="Enter result"
                       data-test="haemoglobin"
                       data-min="12.0"
                       data-max="16.0" />

                <div class="normal-range">

                    <strong>Normal Range:</strong>
                    12.0 – 16.0 g/dL

                </div>

                <small id="haemoglobin-status"
                       class="d-block mt-2 status-neutral">

                    Enter a result to evaluate

                </small>


                <div class="technician-note">

                    <label>
                        Technician Notes
                    </label>

                    <textarea class="form-control"
                              asp-for="HaemoglobinNotes"
                              rows="4"
                              placeholder="Enter notes for Haemoglobin..."></textarea>

                </div>

            </div>

        </div>


        <!-- WHITE CELL COUNT -->
        <div class="col-md-4">

            <div class="result-card">

                <div class="result-card-title">
                    White Cell Count (WCC)
                </div>

                <label class="form-label">
                    Result
                </label>

                <input type="number"
                       step="0.1"
                       class="form-control result-input"
                       asp-for="Wcc"
                       placeholder="Enter result"
                       data-test="wcc"
                       data-min="4.0"
                       data-max="11.0" />

                <div class="normal-range">

                    <strong>Normal Range:</strong>
                    4.0 – 11.0 x10⁹/L

                </div>

                <small id="wcc-status"
                       class="d-block mt-2 status-neutral">

                    Enter a result to evaluate

                </small>


                <div class="technician-note">

                    <label>
                        Technician Notes
                    </label>

                    <textarea class="form-control"
                              asp-for="WccNotes"
                              rows="4"
                              placeholder="Enter notes for White Cell Count..."></textarea>

                </div>

            </div>

        </div>


        <!-- PLATELETS -->
        <div class="col-md-4">

            <div class="result-card">

                <div class="result-card-title">
                    Platelets
                </div>

                <label class="form-label">
                    Result
                </label>

                <input type="number"
                       step="1"
                       class="form-control result-input"
                       asp-for="Platelets"
                       placeholder="Enter result"
                       data-test="platelets"
                       data-min="150"
                       data-max="450" />

                <div class="normal-range">

                    <strong>Normal Range:</strong>
                    150 – 450 x10⁹/L

                </div>

                <small id="platelets-status"
                       class="d-block mt-2 status-neutral">

                    Enter a result to evaluate

                </small>


                <div class="technician-note">

                    <label>
                        Technician Notes
                    </label>

                    <textarea class="form-control"
                              asp-for="PlateletsNotes"
                              rows="4"
                              placeholder="Enter notes for Platelets..."></textarea>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Automatic Result Evaluation -->
<script>

    document.querySelectorAll(".result-input").forEach(function (input) {

        input.addEventListener("input", function () {

            const value = parseFloat(this.value);

            const min = parseFloat(this.dataset.min);
            const max = parseFloat(this.dataset.max);

            const test = this.dataset.test;

            const statusElement =
                document.getElementById(test + "-status");


            // Empty input
            if (this.value === "" || isNaN(value)) {

                statusElement.textContent =
                    "Enter a result to evaluate";

                statusElement.className =
                    "d-block mt-2 status-neutral";

                return;
            }


            // Below normal range
            if (value < min) {

                statusElement.textContent =
                    "Abnormally Low";

                statusElement.className =
                    "d-block mt-2 abnormal";

                return;
            }


            // Above normal range
            if (value > max) {

                statusElement.textContent =
                    "Abnormally High";

                statusElement.className =
                    "d-block mt-2 abnormal";

                return;
            }


            // Within normal range
            statusElement.textContent =
                "Within Normal Range";

            statusElement.className =
                "d-block mt-2 normal";

        });

    });

</script>


            <!-- Test Assignment Reminder -->
            <div class="info-box">

                <h4 class="section-title">
                    Test Assignment
                </h4>

                <div class="locked-test">

                    <i class="fa-solid fa-lock me-2"></i>

                    This screen represents the assigned test for the current laboratory technician.
                    Other test types on the same request should remain unavailable for editing.

                </div>

            </div>


            <!-- Actions -->
            <div class="mt-4">

                <a asp-controller="LabTechnician"
                   asp-action="VerificationQueue"
                   class="btn-dark-custom me-2">

                    <i class="fa-solid fa-check"></i>
                    Save & Complete Test

                </a>

                <button class="btn-dark-custom me-2">

                    <i class="fa-solid fa-flag"></i>
                    Flag Abnormal Result

                </button>

                <a asp-controller="LabTechnician"
                   asp-action="TestDetail"
                   class="btn-outline-custom">

                    View Test Detail

                </a>

            </div>

        </div>

    </div>

</div>