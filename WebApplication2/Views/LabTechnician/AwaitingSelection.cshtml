
@model IEnumerable<WebApplication2.Models.LabTechnicianQueueItem>
    @using WebApplication2.Models

    @{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Awaiting Selection";

    var samples = Model?.Where(x => !x.IsRejected).ToList()
                  ?? new List<LabTechnicianQueueItem>();

    var testTypes = (ViewBag.TestTypes as IEnumerable<LabTechnicianQueueItem>)?.ToList()
                    ?? new List<LabTechnicianQueueItem>();

    var consumables = (ViewBag.Consumables as IEnumerable<ConsumableStockItem>)?.ToList()
                      ?? new List<ConsumableStockItem>();
    }

    <link href="~/css/dashboardstyles.css" rel="stylesheet" />

    <style>
        .awaiting-page {
            padding: 24px;
            background: #f8fafc;
        }

        .awaiting-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 24px;
        }

        .sample-card {
            background: #f8fafc;
            border: 1px solid #dbe3ec;
            border-left: 4px solid #2563eb;
            border-radius: 12px;
            padding: 18px;
            margin-bottom: 14px;
        }

            .sample-card.expanded {
                background: #f0f6fc;
            }

        .details-panel {
            display: none;
            margin-top: 18px;
        }

        .info-section {
            background: #fff;
            border: 1px solid #dbe3ec;
            border-radius: 10px;
            padding: 16px;
            margin-top: 12px;
        }

        .section-title {
            font-weight: 700;
            margin-bottom: 12px;
            color: #0f172a;
        }

        .info-box {
            height: 100%;
            padding: 12px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            overflow-wrap: anywhere;
        }

        .info-label {
            color: #64748b;
            font-size: .7rem;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .info-value {
            color: #1f2937;
            font-weight: 600;
        }

        .pill {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: .75rem;
            font-weight: 700;
            margin: 3px;
            background: #e2e8f0;
            color: #334155;
        }

        .pill-stat {
            background: #ffedd5;
            color: #9a3412;
        }

        .pill-urgent, .pill-out {
            background: #fee2e2;
            color: #991b1b;
        }

        .pill-routine {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .pill-low {
            background: #fef3c7;
            color: #92400e;
        }

        .pill-good {
            background: #dcfce7;
            color: #166534;
        }

        .action-button {
            border: 1px solid #2563eb;
            border-radius: 8px;
            padding: 8px 12px;
            background: #fff;
            color: #2563eb;
        }

        .stock-row, .test-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 11px 0;
            border-bottom: 1px solid #e5e7eb;
        }

            .stock-row:last-child, .test-row:last-child {
                border-bottom: 0;
            }

        .empty-state {
            padding: 24px;
            border: 1px dashed #cbd5e1;
            border-radius: 10px;
            text-align: center;
            color: #64748b;
        }

        @@media(max-width: 768px) {
            .awaiting-page {
                padding: 10px;
            }

            .awaiting-card {
                padding: 14px;
            }
        }
    </style>

    <div class="main-content">
        <div class="awaiting-page">
            <div class="awaiting-card">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                    <div>
                        <h1 class="mb-1">Awaiting Selection</h1>
                        <p class="text-muted mb-0">Received samples waiting for laboratory technician selection.</p>
                    </div>
                    <a asp-controller="LabTechnician" asp-action="Dashboard" class="btn btn-primary">
                        <i class="fa-solid fa-arrow-left"></i> Dashboard
                    </a>
                </div>

                @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }
                @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <input id="sampleSearch" class="form-control" placeholder="Search request, patient or barcode..." />
                    </div>
                    <div class="col-md-4">
                        <select id="priorityFilter" class="form-select">
                            <option value="">All priorities</option>
                            <option value="stat">STAT</option>
                            <option value="urgent">Urgent</option>
                            <option value="routine">Routine</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select id="typeFilter" class="form-select">
                            <option value="">All request types</option>
                            @foreach (var test in testTypes)
                        {
                            if (!string.IsNullOrWhiteSpace(test.TestName))
                            {
                            <option value="@test.TestName.ToLowerInvariant()">@test.TestName</option>
                            }
                        }
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Received Samples</h4>
                    <span class="pill">@samples.Count sample(s)</span>
                </div>

                @if (samples.Count == 0)
            {
                <div class="empty-state">
                    <i class="fa-solid fa-vials fa-2x mb-3"></i>
                    <p class="mb-1">No received samples are awaiting selection.</p>
                    <small>Samples appear here after they have been received in Receive Samples.</small>
                </div>
            }
            else
            {
                <div id="sampleList">
                    @foreach (var sample in samples)
                    {
                        var urgency = (sample.Urgency ?? "").Trim();
                        var requestType = (sample.Type ?? "").Trim();
                        var searchText = $"{sample.TestRequestID} {sample.PatientName} {sample.Barcode} {requestType}".ToLowerInvariant();

                    <article class="sample-card"
                             data-search="@searchText"
                             data-priority="@urgency.ToLowerInvariant()"
                             data-type="@requestType.ToLowerInvariant()">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                            <div>
                                <h4 class="mb-2">Request #@sample.TestRequestID</h4>
                                <p class="mb-1"><strong>Patient:</strong> @(string.IsNullOrWhiteSpace(sample.PatientName) ? "Not available" : sample.PatientName)</p>
                                <p class="mb-2"><strong>Request type:</strong> @(string.IsNullOrWhiteSpace(requestType) ? "Not specified" : requestType)</p>

                                @if (urgency.Equals("STAT", StringComparison.OrdinalIgnoreCase))
                                    {
                                <span class="pill pill-stat">STAT</span>
                                    }
                                    else if (urgency.Equals("Urgent", StringComparison.OrdinalIgnoreCase))
                                    {
                                <span class="pill pill-urgent">Urgent</span>
                                    }
                                    else if (urgency.Equals("Routine", StringComparison.OrdinalIgnoreCase))
                                    {
                                <span class="pill pill-routine">Routine</span>
                                    }
                                    else
                                    {
                                <span class="pill">@(string.IsNullOrWhiteSpace(urgency) ? "Priority not specified" : urgency)</span>
                                    }
                                <span class="pill">Received</span>
                            </div>

                            <button type="button" class="action-button" aria-expanded="false" onclick="toggleDetails(this)">
                                <i class="fa-solid fa-chevron-down"></i> View More
                            </button>
                        </div>

                        <div class="details-panel">
                            <section class="info-section">
                                <div class="section-title"><i class="fa-solid fa-vial"></i> Sample Information</div>
                                <div class="row g-3">
                                    <div class="col-md-6"><div class="info-box"><div class="info-label">Sample Receipt ID</div><div class="info-value">@sample.SampleReceiptID</div></div></div>
                                    <div class="col-md-6"><div class="info-box"><div class="info-label">Barcode</div><div class="info-value">@(string.IsNullOrWhiteSpace(sample.Barcode) ? "Not available" : sample.Barcode)</div></div></div>
                                    <div class="col-md-6"><div class="info-box"><div class="info-label">Request Date</div><div class="info-value">@sample.RequestDate.ToString("yyyy-MM-dd HH:mm")</div></div></div>
                                    <div class="col-md-6"><div class="info-box"><div class="info-label">Date and Time Received</div><div class="info-value">@(sample.DateTimeReceived?.ToString("yyyy-MM-dd HH:mm") ?? "Not available")</div></div></div>
                                    <div class="col-md-6"><div class="info-box"><div class="info-label">Patient ID</div><div class="info-value">@sample.PatientID</div></div></div>
                                    <div class="col-md-6"><div class="info-box"><div class="info-label">Patient Number</div><div class="info-value">@(string.IsNullOrWhiteSpace(sample.PatientNumber) ? "Not available" : sample.PatientNumber)</div></div></div>
                                </div>
                            </section>

                            <section class="info-section">
                                <div class="section-title"><i class="fa-solid fa-clipboard-list"></i> Request Summary</div>
                                <div class="row g-3">
                                    <div class="col-md-6"><div class="info-box"><div class="info-label">Request Number</div><div class="info-value">@sample.TestRequestID</div></div></div>
                                    <div class="col-md-6"><div class="info-box"><div class="info-label">Patient</div><div class="info-value">@sample.PatientName</div></div></div>
                                </div>
                                <div class="mt-3">
                                    <div class="info-label">Request Type from Database</div>
                                    <div class="info-box">@(string.IsNullOrWhiteSpace(requestType) ? "No request type recorded" : requestType)</div>
                                </div>
                                <div class="alert alert-info mt-3 mb-0">
                                    The database stores a request Type and a separate TestType catalogue, but no confirmed relationship currently maps each request to its individual requested tests. The catalogue is not automatically treated as tests ordered for this patient.
                                </div>
                            </section>

                            <section class="info-section">
                                <div class="section-title"><i class="fa-solid fa-box-open"></i> Consumable Stock</div>
                                @if (consumables.Count == 0)
                                    {
                                <div class="empty-state">No consumable inventory records were returned from the database.</div>
                                    }
                                    else
                                    {
                                <p class="text-muted small">Live quantities from the Consumable table. The current schema does not map individual consumables to individual tests.</p>
                                foreach (var item in consumables)
                                        {
                                            var outOfStock = item.QtyOnHand <= 0;
                                            var lowStock = !outOfStock && item.QtyOnHand <= item.ReOrderLevel;

                                <div class="stock-row">
                                    <div>
                                        <strong>@item.Name</strong>
                                        <div class="text-muted small">Reorder level: @item.ReOrderLevel</div>
                                    </div>
                                    <div class="text-end">
                                        <strong>@item.QtyOnHand on hand</strong><br />
                                        @if (outOfStock)
                                                    {
                                        <span class="pill pill-out">Out of stock</span>
                                                    }
                                                    else if (lowStock)
                                                    {
                                        <span class="pill pill-low">Low stock</span>
                                                    }
                                                    else
                                                    {
                                        <span class="pill pill-good">Available</span>
                                                    }
                                    </div>
                                </div>
                                        }
                                    }
                            </section>

                            <section class="info-section">
                                <div class="section-title"><i class="fa-solid fa-flask"></i> Available Test Type Catalogue</div>
                                @if (testTypes.Count == 0)
                                    {
                                <div class="empty-state">No test types were returned from the TestType table.</div>
                                    }
                                    else
                                    {
                                foreach (var test in testTypes)
                                        {
                                <div class="test-row">
                                    <div>
                                        <strong>@test.TestName</strong>
                                        <div class="text-muted small">Test type ID: @test.TestTypeID</div>
                                    </div>
                                    <span class="pill">TAT: @test.TurnAroundMinutes min</span>
                                </div>
                                        }
                                    }
                            </section>

                            <div class="alert alert-warning mt-3 mb-0">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Test selection and the turnaround timer are not started here because the current schema does not identify which tests belong to this request or which consumables each test requires.
                            </div>
                        </div>
                    </article>
                    }
                </div>

                <div id="noMatches" class="empty-state mt-3" style="display:none;">
                    No samples match your search or filters.
                </div>
            }
            </div>
        </div>
    </div>

    <script>
        function toggleDetails(button) {
            const card = button.closest(".sample-card");
            const panel = card?.querySelector(".details-panel");
            if (!card || !panel) return;

            const expanded = panel.style.display === "block";
            panel.style.display = expanded ? "none" : "block";
            card.classList.toggle("expanded", !expanded);
            button.setAttribute("aria-expanded", String(!expanded));
            button.innerHTML = expanded
                ? '<i class="fa-solid fa-chevron-down"></i> View More'
                : '<i class="fa-solid fa-chevron-up"></i> View Less';
        }

        function filterSamples() {
            const search = (document.getElementById("sampleSearch")?.value || "").trim().toLowerCase();
            const priority = (document.getElementById("priorityFilter")?.value || "").toLowerCase();
            const type = (document.getElementById("typeFilter")?.value || "").toLowerCase();
            const cards = document.querySelectorAll(".sample-card");
            let visibleCount = 0;

            cards.forEach(card => {
                const visible =
                    (card.dataset.search || "").includes(search) &&
                    (!priority || (card.dataset.priority || "").includes(priority)) &&
                    (!type || (card.dataset.type || "").includes(type));

                card.style.display = visible ? "" : "none";
                if (visible) visibleCount++;
            });

            const noMatches = document.getElementById("noMatches");
            if (noMatches) noMatches.style.display =
                cards.length > 0 && visibleCount === 0 ? "block" : "none";
        }

        document.getElementById("sampleSearch")?.addEventListener("input", filterSamples);
        document.getElementById("priorityFilter")?.addEventListener("change", filterSamples);
        document.getElementById("typeFilter")?.addEventListener("change", filterSamples);
    </script>
