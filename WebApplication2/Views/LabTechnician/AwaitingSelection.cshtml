@{
    Layout = "~/Views/Shared/_LabTechLayout.cshtml";
    ViewData["Title"] = "Awaiting Selection";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css" rel="stylesheet" />

<style>
    .page-container {
        padding: 0;
    }

    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .queue-card {
        background: #f8fafc;
        border-radius: 16px;
        padding: 22px;
        margin-bottom: 20px;
        border-left: 4px solid #2563eb;
        border-top: 1px solid #e2e8f0;
        border-right: 1px solid #e2e8f0;
        border-bottom: 1px solid #e2e8f0;
        transition: 0.2s ease;
    }

        .queue-card:hover {
            background: #f1f5f9;
            transform: translateX(4px);
        }

    .status-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        margin-right: 6px;
        margin-top: 5px;
        font-weight: 600;
    }

    .badge-stat {
        background: #f4a261;
        color: black;
    }

    .badge-routine {
        background: #d9e6f2;
        color: black;
    }

    .badge-overdue {
        background: #dc3545;
        color: white;
    }

    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }

    .btn-outline-custom {
        background: white;
        border: 1px solid #0d6efd;
        color: #0d6efd !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-outline-custom:hover {
            background: #eef5ff;
        }

    .text-muted {
        color: #6b7280 !important;
    }

    .filter-box,
    .form-control,
    .form-select {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #ffffff;
            color: #1f2937;
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }

    h1,
    h4,
    p,
    strong {
        color: #1f2937;
    }

    .info-section {
        margin-top: 20px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #dbe3ec;
        border-radius: 12px;
    }

    .info-section-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 12px;
    }

    .info-item {
        margin-bottom: 10px;
    }

        .info-item:last-child {
            margin-bottom: 0;
        }

    .info-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .info-value {
        font-size: 0.9rem;
        color: #1f2937;
    }

    .clinical-notes {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 12px;
        color: #1e3a8a;
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .consumable-list {
        margin: 0;
        padding-left: 20px;
        color: #374151;
    }

    .sample-box {
        background: #f8fafc;
        border: 1px solid #dbe3ec;
        border-radius: 10px;
        padding: 12px 15px;
    }

    .sample-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        color: #64748b;
        font-weight: 700;
    }

    .sample-value {
        font-weight: 600;
        color: #1f2937;
        margin-top: 3px;
    }
</style>


<!-- MAIN CONTENT -->
<div class="main-content">

    <div class="page-container">

        <div class="card-dark">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>

                    <h1>
                        Awaiting Selection
                    </h1>

                    <p class="text-muted">
                        Tests waiting for laboratory technician selection and processing.
                    </p>

                </div>

                <a asp-controller="Home"
                   asp-action="LabTechnicianDashboard"
                   class="btn-dark-custom">

                    ← Dashboard

                </a>

            </div>


            <!-- Filters -->
            <div class="row g-3 mb-4">

                <div class="col-md-4">

                    <input class="form-control filter-box"
                           placeholder="Search request number..." />

                </div>

                <div class="col-md-4">

                    <select class="form-select filter-box">

                        <option>All Priorities</option>
                        <option>STAT</option>
                        <option>Urgent</option>
                        <option>Routine</option>

                    </select>

                </div>

                <div class="col-md-4">

                    <select class="form-select filter-box">

                        <option>All Test Types</option>
                        <option>Haematology</option>
                        <option>Chemistry</option>

                    </select>

                </div>

            </div>


            <!-- QUEUE ITEM 1 -->
            <div class="queue-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="flex-grow-1">

                        <h4>
                            REQ-2026-00124
                        </h4>

                        <p class="mb-2">
                            <strong>Patient:</strong>
                            Baloyi, Thabo
                        </p>

                        <p class="mb-2">
                            <strong>Test Type:</strong>
                            FBC + Differential
                        </p>

                        <span class="status-badge badge-stat">
                            STAT
                        </span>

                        <span class="status-badge badge-overdue">
                            Nearing TAT Limit
                        </span>


                        <!-- SAMPLE INFORMATION -->
                        <div class="info-section">

                            <div class="info-section-title">
                                <i class="fa-solid fa-vial"></i>
                                Sample Required
                            </div>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <div class="sample-box">

                                        <div class="sample-label">
                                            Sample Type
                                        </div>

                                        <div class="sample-value">
                                            Whole Blood
                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="sample-box">

                                        <div class="sample-label">
                                            Sample Barcode
                                        </div>

                                        <div class="sample-value">
                                            BC-889213
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- CONSUMABLES -->
                        <div class="info-section">

                            <div class="info-section-title">
                                <i class="fa-solid fa-box-open"></i>
                                Consumables Required
                            </div>

                            <ul class="consumable-list">

                                <li>EDTA Blood Collection Tube</li>
                                <li>Gloves</li>
                                <li>Microscope Slide</li>

                            </ul>

                        </div>


                        <!-- PATIENT INFORMATION -->
                        <div class="info-section">

                            <div class="info-section-title">
                                <i class="fa-solid fa-user"></i>
                                Patient Clinical Information
                            </div>

                            <div class="row">

                                <div class="col-md-4 info-item">

                                    <div class="info-label">
                                        Conditions
                                    </div>

                                    <div class="info-value">
                                        Anaemia
                                    </div>

                                </div>

                                <div class="col-md-4 info-item">

                                    <div class="info-label">
                                        Allergies
                                    </div>

                                    <div class="info-value">
                                        Penicillin
                                    </div>

                                </div>

                                <div class="col-md-4 info-item">

                                    <div class="info-label">
                                        Medication
                                    </div>

                                    <div class="info-value">
                                        Ferrous Sulphate
                                    </div>

                                </div>

                            </div>

                            <div class="mt-3">

                                <div class="info-label">
                                    Clinical Notes from Doctor
                                </div>

                                <div class="clinical-notes">

                                    Patient presents with fatigue and suspected iron deficiency.
                                    Please process FBC and differential as a priority.

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ACTIONS -->
                    <div class="text-end ms-4">

                        <p class="text-danger fw-bold">
                            Due in 12 minutes
                        </p>

                        <div class="d-flex flex-column gap-2">

                            <a asp-controller="LabTechnician"
                               asp-action="TestDetail"
                               class="btn-outline-custom">

                                View Details

                            </a>

                            <a asp-controller="LabTechnician"
                               asp-action="CaptureResults"
                               class="btn-dark-custom">

                                <i class="fa-solid fa-play"></i>
                                Start Test

                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- QUEUE ITEM 2 -->
            <div class="queue-card">

                <div class="d-flex justify-content-between align-items-start">

                    <div class="flex-grow-1">

                        <h4>
                            REQ-2026-00125
                        </h4>

                        <p class="mb-2">
                            <strong>Patient:</strong>
                            Jacobs, Lerato
                        </p>

                        <p class="mb-2">
                            <strong>Test Type:</strong>
                            ESR
                        </p>

                        <span class="status-badge badge-routine">
                            Routine
                        </span>


                        <!-- SAMPLE INFORMATION -->
                        <div class="info-section">

                            <div class="info-section-title">
                                <i class="fa-solid fa-vial"></i>
                                Sample Required
                            </div>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <div class="sample-box">

                                        <div class="sample-label">
                                            Sample Type
                                        </div>

                                        <div class="sample-value">
                                            Serum
                                        </div>

                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="sample-box">

                                        <div class="sample-label">
                                            Sample Barcode
                                        </div>

                                        <div class="sample-value">
                                            BC-889214
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- CONSUMABLES -->
                        <div class="info-section">

                            <div class="info-section-title">
                                <i class="fa-solid fa-box-open"></i>
                                Consumables Required
                            </div>

                            <ul class="consumable-list">

                                <li>ESR Tube</li>
                                <li>Gloves</li>
                                <li>ESR Pipette</li>

                            </ul>

                        </div>


                        <!-- PATIENT INFORMATION -->
                        <div class="info-section">

                            <div class="info-section-title">
                                <i class="fa-solid fa-user"></i>
                                Patient Clinical Information
                            </div>

                            <div class="row">

                                <div class="col-md-4 info-item">

                                    <div class="info-label">
                                        Conditions
                                    </div>

                                    <div class="info-value">
                                        No known conditions
                                    </div>

                                </div>

                                <div class="col-md-4 info-item">

                                    <div class="info-label">
                                        Allergies
                                    </div>

                                    <div class="info-value">
                                        None reported
                                    </div>

                                </div>

                                <div class="col-md-4 info-item">

                                    <div class="info-label">
                                        Medication
                                    </div>

                                    <div class="info-value">
                                        None reported
                                    </div>

                                </div>

                            </div>

                            <div class="mt-3">

                                <div class="info-label">
                                    Clinical Notes from Doctor
                                </div>

                                <div class="clinical-notes">

                                    Routine ESR requested for inflammatory marker assessment.

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ACTIONS -->
                    <div class="text-end ms-4">

                        <p class="text-success fw-bold">
                            Within TAT
                        </p>

                        <div class="d-flex flex-column gap-2">

                            <a asp-controller="LabTechnician"
                               asp-action="TestDetail"
                               class="btn-outline-custom">

                                View Details

                            </a>

                            <a asp-controller="LabTechnician"
                               asp-action="CaptureResults"
                               class="btn-dark-custom">

                                <i class="fa-solid fa-play"></i>
                                Start Test

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>