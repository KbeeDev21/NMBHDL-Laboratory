@model IEnumerable<dynamic>

<div class="container-fluid p-4 text-start animate-fade-in" style="background-color: #ffffff;">
    <div class="mb-4 border-bottom pb-3">
        <h2 class="fw-bold text-dark mb-1">Issue Laboratory Test Request</h2>
        <p class="text-muted m-0 small">Deploy pathology diagnostic orders into the laboratory workstream registry</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="card border border-light-subtle shadow-sm" style="border-radius: 14px;">
                <div class="card-body p-4">
                    <form id="requestForm" onsubmit="event.preventDefault(); showToast('Order Confirmed', 'Test suite request has been published into the lab queue successfully. Patient notified via email.', 'success');">

                        <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-user-injured text-primary me-2"></i>1. Selected Patient Target</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-8">
                                <label class="form-label text-secondary small fw-semibold">Search Registered Master Patient File</label>
                                <select class="form-select" required style="border-radius: 8px; padding: 11px;">
                                    <option value="" disabled selected>Select patient matching record parameters...</option>
                                    @foreach (var p in ViewBag.PatientsList)
                                    {
                                        <option value="@p.IdNumber">@p.FullName (@p.IdNumber)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-secondary small fw-semibold">Request Creation Date</label>
                                <input type="date" class="form-control text-muted" value="@DateTime.Now.ToString("yyyy-MM-dd")" required style="border-radius: 8px; padding: 11px;" />
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-microscope text-primary me-2"></i>2. Requested Diagnostic Panels</h5>
                        <p class="text-muted small mb-3">Check all requested metrics that match clinical analysis directives</p>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle d-flex align-items-center">
                                    <div class="form-check m-0">
                                        <input class="form-check-input sample-trigger" type="checkbox" data-sample="Whole Blood (Purple EDTA Tube)" id="fbc" style="cursor: pointer; width: 18px; height: 18px;">
                                        <label class="form-check-label text-dark fw-medium ms-2" for="fbc" style="cursor: pointer;">Full Blood Count (FBC)</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle d-flex align-items-center">
                                    <div class="form-check m-0">
                                        <input class="form-check-input sample-trigger" type="checkbox" data-sample="Whole Blood (Purple EDTA Tube)" id="hb" style="cursor: pointer; width: 18px; height: 18px;">
                                        <label class="form-check-label text-dark fw-medium ms-2" for="hb" style="cursor: pointer;">Hemoglobin (Hb) Isolation</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle d-flex align-items-center">
                                    <div class="form-check m-0">
                                        <input class="form-check-input sample-trigger" type="checkbox" data-sample="Blood Smear Slide" id="diff" style="cursor: pointer; width: 18px; height: 18px;">
                                        <label class="form-check-label text-dark fw-medium ms-2" for="diff" style="cursor: pointer;">Differential Counts (Diff Counts)</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle d-flex align-items-center">
                                    <div class="form-check m-0">
                                        <input class="form-check-input sample-trigger" type="checkbox" data-sample="Whole Blood (Purple EDTA Tube)" id="platelets" style="cursor: pointer; width: 18px; height: 18px;">
                                        <label class="form-check-label text-dark fw-medium ms-2" for="platelets" style="cursor: pointer;">Platelet Count (PLT)</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle d-flex align-items-center">
                                    <div class="form-check m-0">
                                        <input class="form-check-input sample-trigger" type="checkbox" data-sample="Citrated Plasma (Light Blue Tube)" id="inr" style="cursor: pointer; width: 18px; height: 18px;">
                                        <label class="form-check-label text-dark fw-medium ms-2" for="inr" style="cursor: pointer;">Prothrombin Time & INR</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="sampleNoticeBlock" class="alert alert-info border-info-subtle mb-4 d-none animate-fade-in" style="border-radius: 10px; background-color: #f0f9ff;">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-circle-info fs-5 me-3 text-info-emphasis"></i>
                                <div>
                                    <strong class="text-info-emphasis d-block small uppercase fw-bold">Required Specimen Protocols:</strong>
                                    <span id="requiredSamplesList" class="text-dark fw-medium small">None</span>
                                </div>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-barcode text-primary me-2"></i>3. Specimen Barcoding & Urgency</h5>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label text-secondary small fw-semibold">Urgency Tier Level</label>
                                <select class="form-select" required style="border-radius: 8px; padding: 10px;">
                                    <option value="Routine">Routine (Turnaround Base)</option>
                                    <option value="Urgent">Urgent (Priority Buffer)</option>
                                    <option value="STAT">STAT (Immediate Interrupt Flags)</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label text-secondary small fw-semibold">Specimen Barcode Number(s) (Required)</label>
                                <input type="text" class="form-control font-monospace fw-bold" placeholder="Scan or type vial barcodes (e.g. BAR-88192-01)" pattern="^[A-Za-z0-9\-, ]+$" title="Barcode inputs must only contain alphanumeric identifiers, hyphens, spaces, or commas" required style="border-radius: 8px; padding: 10px; border-left: 3px solid #0284c7;" />
                            </div>
                            <div class="col-12">
                                <label class="form-label text-secondary small fw-semibold">Clinical Symptoms / Directives Notes</label>
                                <input type="text" class="form-control" placeholder="Append specific flags or clinical symptom details here..." style="border-radius: 8px; padding: 10px;" />
                            </div>
                        </div>

                        <hr class="my-4 text-light-subtle">

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" onclick="loadSection('dashboard')" class="btn btn-light px-4 fw-semibold text-secondary" style="border-radius: 8px; padding: 10px 24px;">Abort Form</button>
                            <button type="submit" class="btn btn-primary px-4 fw-semibold" style="border-radius: 8px; padding: 10px 24px; background-color: #0284c7; border-color: #0284c7;">
                                <i class="fa-solid fa-paper-plane me-2"></i>Dispatch Lab Directive Order
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .animate-fade-in {
        animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-control:focus, .form-select:focus {
        border-color: #0284c7 !important;
        box-shadow: 0 0 0 0.25rem rgba(2, 132, 199, 0.15) !important;
    }
</style>

<script>
    document.querySelectorAll('.sample-trigger').forEach(item => {
        item.addEventListener('change', () => {
            let samples = [];
            document.querySelectorAll('.sample-trigger:checked').forEach(checkedItem => {
                let sampleType = checkedItem.getAttribute('data-sample');
                if (!samples.includes(sampleType)) samples.push(sampleType);
            });

            let notice = document.getElementById('sampleNoticeBlock');
            if (samples.length > 0) {
                notice.classList.remove('d-none');
                document.getElementById('requiredSamplesList').innerText = samples.join(' | ');
            } else {
                notice.classList.add('d-none');
            }
        });
    });
</script>