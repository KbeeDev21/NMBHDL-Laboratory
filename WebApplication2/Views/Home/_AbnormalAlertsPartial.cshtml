@model IEnumerable<dynamic>

<div class="container-fluid p-4 text-start animate-fade-in" style="background-color: #ffffff;">
    <div class="mb-4 border-bottom pb-3">
        <h2 class="fw-bold text-dark mb-1">Clinical Operations Dashboard</h2>
        <p class="text-muted m-0 small">Real-time surveillance matrix for critical patient parameters</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Active Requests</div>
                        <div class="fs-3 fw-bold text-dark">@ViewBag.TotalActiveRequests</div>
                    </div>
                    <div class="bg-primary-subtle rounded-3 p-2 text-primary"><i class="fa-solid fa-vials fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 12px; border-left: 4px solid #ef4444 !important;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Critical Alerts (5d)</div>
                        <div class="fs-3 fw-bold text-danger">@ViewBag.CriticalAlertsCount</div>
                    </div>
                    <div class="bg-danger-subtle rounded-3 p-2 text-danger"><i class="fa-solid fa-triangle-exclamation fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Pending Collections</div>
                        <div class="fs-3 fw-bold text-dark">@ViewBag.PendingCollections</div>
                    </div>
                    <div class="bg-warning-subtle rounded-3 p-2 text-warning"><i class="fa-solid fa-box-tissue fa-lg"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 12px;">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Turnaround Compliance</div>
                        <div class="fs-3 fw-bold text-success">@ViewBag.TurnaroundCompliance</div>
                    </div>
                    <div class="bg-success-subtle rounded-3 p-2 text-success"><i class="fa-solid fa-clock-check fa-lg"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-6">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 14px;">
                <div class="card-header bg-transparent border-0 pt-3 px-4 d-flex flex-sm-row flex-column justify-content-between align-items-start align-items-sm-center gap-2">
                    <h5 class="fw-bold text-danger m-0"><i class="fa-solid fa-bell me-2"></i>Abnormal Critical Flags</h5>

                    <div class="d-flex align-items-center gap-1">
                        <label class="text-muted small fw-semibold text-nowrap me-1">Scope:</label>
                        <select class="form-select form-select-sm" id="alertScopeFilter" onchange="showToast('Scope Shift', 'Querying database archival layers for older abnormal records...', 'info')" style="border-radius: 6px; width: 160px;">
                            <option value="5" selected>Last 5 Days (Default)</option>
                            <option value="14">Last 14 Days</option>
                            <option value="30">Last 30 Days</option>
                            <option value="all">All Historical Archive</option>
                        </select>
                    </div>
                </div>

                <div class="card-body px-4">
                    <div class="d-flex flex-column gap-3 mb-3">
                        @foreach (var alert in Model)
                        {
                            var badgeClass = alert.AlertLevel.Contains("High") ? "bg-danger text-white" : "bg-warning text-dark";
                            <div class="p-3 border border-light-subtle rounded-3 bg-light-subtle position-relative" style="transition: transform 0.2s;">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="fw-bold text-dark m-0">@alert.Surname, @alert.FirstName</h6>
                                        <small class="text-muted font-monospace">ID: @alert.IdNumber</small>
                                    </div>
                                    <span class="badge @badgeClass fw-semibold text-uppercase small">@alert.AlertLevel</span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top border-light-subtle mb-2">
                                    <div>
                                        <small class="text-secondary d-block">@alert.TestName</small>
                                        <strong class="text-dark fs-5">@alert.ResultValue <span class="small text-muted fs-6">@alert.Unit</span></strong>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-secondary-subtle text-secondary font-monospace small mb-1 d-block">@alert.RefRange</span>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;"><i class="fa-regular fa-clock me-1"></i>@alert.Date</small>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2 pt-1">
                                    <button onclick="showToast('Report Retrieval', 'Compiling absolute clinical ledger to PDF layout package...', 'success')" class="btn btn-sm btn-light border border-light-subtle text-secondary fw-semibold px-2" style="font-size: 0.78rem; border-radius: 6px;">
                                        <i class="fa-solid fa-file-pdf text-danger me-1"></i>Print PDF
                                    </button>
                                    <button class="btn btn-sm btn-primary fw-semibold px-3" data-bs-toggle="modal" data-bs-target="#releaseModal" onclick="setupReleaseModal('@alert.Surname, @alert.FirstName', '@alert.TestName', '@alert.ResultValue @alert.Unit')" style="font-size: 0.78rem; border-radius: 6px; background-color: #0284c7; border-color: #0284c7;">
                                        <i class="fa-solid fa-share-from-square me-1"></i>Release to Patient
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card border border-light-subtle shadow-sm h-100" style="border-radius: 14px;">
                <div class="card-header bg-transparent border-0 pt-3 ps-4">
                    <h5 class="fw-bold text-dark m-0"><i class="fa-solid fa-list-check text-primary me-2"></i>Recent Workstream Requests</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover m-0">
                            <thead class="bg-light text-secondary small uppercase">
                                <tr>
                                    <th class="ps-4">Request Ref</th>
                                    <th>Patient</th>
                                    <th>Urgency</th>
                                    <th>Status</th>
                                    <th class="pe-4 text-end">Updated</th>
                                </tr>
                            </thead>
                            <tbody class="text-dark small border-top-0">
                                @foreach (var req in ViewBag.RecentRequests)
                                {
                                    var urgencyBadge = req.Urgency == "STAT" ? "bg-danger-subtle text-danger" : req.Urgency == "Urgent" ? "bg-warning-subtle text-warning-emphasis" : "bg-info-subtle text-info-emphasis";
                                    <tr>
                                        <td class="ps-4 font-monospace fw-semibold text-primary">@req.RequestNumber</td>
                                        <td>
                                            <div class="fw-bold">@req.PatientName</div>
                                            <small class="text-muted font-monospace" style="font-size: 0.72rem;">@req.IdNumber</small>
                                        </td>
                                        <td><span class="badge @urgencyBadge px-2 py-1 fw-semibold">@req.Urgency</span></td>
                                        <td><span class="badge bg-light text-dark border border-light-subtle px-2 py-1">@req.Status</span></td>
                                        <td class="pe-4 text-end text-muted">@req.TimeElapsed</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="releaseModal" tabindex="-1" aria-labelledby="releaseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 14px;">
            <div class="modal-header border-bottom px-4 pt-4 pb-2">
                <h5 class="modal-title fw-bold text-dark" id="releaseModalLabel"><i class="fa-solid fa-paper-plane text-success me-2"></i>Authorize Diagnostics Release</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form onsubmit="event.preventDefault(); bootstrap.Modal.getInstance(document.getElementById('releaseModal')).hide(); showToast('Transmission Complete', 'Results have been compiled, flagged, and securely released to the patient portal.', 'success');">
                <div class="modal-body p-4 text-start">
                    <div class="mb-3 bg-light p-3 rounded-3 border border-light-subtle">
                        <div class="small text-secondary fw-semibold mb-1">Target Patient:</div>
                        <div class="fw-bold text-dark mb-2" id="modalTargetPatient">-</div>
                        <div class="row g-2">
                            <div class="col-6">
                                <small class="text-secondary d-block" style="font-size: 0.75rem;">Analysis Metric:</small>
                                <span class="small fw-semibold text-dark" id="modalTargetTest">-</span>
                            </div>
                            <div class="col-6">
                                <small class="text-secondary d-block" style="font-size: 0.75rem;">Observed Value:</small>
                                <span class="small fw-semibold text-danger" id="modalTargetValue">-</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label text-secondary small fw-semibold">Optional Practitioner Consultation Notes</label>
                        <textarea class="form-control" id="patientReleaseNotes" rows="3" placeholder="Type instructions or reassuring commentary to sync straight onto the patient's personal records feed..." style="border-radius: 8px; font-size: 0.88rem;"></textarea>
                    </div>
                    <small class="text-muted d-block bg-light-subtle p-2 border rounded" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-shield-halved text-primary me-1"></i> <strong>Security Action Policy:</strong> Clicking transmit will change the tracking vector status state index to <span class="fw-bold">"Released by Doctor"</span> and dispatch an automated email broadcast link to the target recipient instantly.
                    </small>
                </div>
                <div class="modal-footer border-top bg-light-subtle px-4 py-3" style="border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;">
                    <button type="button" class="btn btn-light text-secondary fw-semibold font-sm" data-bs-dismiss="modal" style="border-radius: 8px;">Abort</button>
                    <button type="submit" class="btn btn-success fw-semibold px-4" style="border-radius: 8px;">
                        <i class="fa-solid fa-circle-check me-2"></i>Sign & Transmit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .animate-fade-in {
        animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-control:focus, .form-select:focus {
        border-color: #0284c7 !important;
        box-shadow: 0 0 0 0.25rem rgba(2, 132, 199, 0.15) !important;
    }
</style>

<script>
    function setupReleaseModal(patientName, testName, observedValue) {
        document.getElementById('modalTargetPatient').innerText = patientName;
        document.getElementById('modalTargetTest').innerText = testName;
        document.getElementById('modalTargetValue').innerText = observedValue;
        document.getElementById('patientReleaseNotes').value = "";
    }
</script>