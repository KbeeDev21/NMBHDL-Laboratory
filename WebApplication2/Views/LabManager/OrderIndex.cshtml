    <!-- Table search / filter (inline, no external js file) -->
    <script>

        (function () {

            const table = document.getElementById("dataTable");
            const search = document.getElementById("searchBox");
            const filter = document.getElementById("filterBox");
            const countText = document.getElementById("countText");
            const noResults = document.getElementById("noResults");
            const noun = countText ? countText.getAttribute("data-noun") : "records";
            const nounOne = countText ? countText.getAttribute("data-noun-one") : noun;

            function applyFilters() {

                const term = search ? search.value.trim().toLowerCase() : "";
                const choice = filter ? filter.value : "";
                const rows = table.querySelectorAll("tbody tr[data-row]");
                let visible = 0;

                rows.forEach(function (row) {

                    const matchesText = row.textContent.toLowerCase().indexOf(term) !== -1;
                    const matchesFilter = !choice || row.getAttribute("data-status") === choice;
                    const show = matchesText && matchesFilter;

                    row.style.display = show ? "" : "none";
                    if (show) visible++;

                });

                if (noResults) noResults.style.display = visible === 0 ? "" : "none";
                if (countText) countText.textContent = visible + " " + (visible === 1 ? nounOne : noun);

            }

            if (search) search.addEventListener("input", applyFilters);
            if (filter) filter.addEventListener("change", applyFilters);

            applyFilters();

        })();

    </script>

