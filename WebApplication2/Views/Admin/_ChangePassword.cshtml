@{
    Layout = null;
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<link href="~/css/dashboardstyles.css"
      rel="stylesheet" />


<style>

    .page-container {
        max-width: 700px;
        margin: 50px auto;
        padding: 0 20px;
    }


    .card-dark {
        background: #ffffff;
        border-radius: 20px;
        padding: 35px;
        border: 1px solid #dbe3ec;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }


    .form-control,
    .form-control:focus {
        background: #ffffff;
        color: #1f2937;
        border: 1px solid #d1d5db;
        box-shadow: none;
    }


        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.15rem rgba(59,130,246,0.15);
        }


    .btn-dark-custom {
        background: #0d6efd;
        border: 1px solid #0d6efd;
        color: white !important;
        border-radius: 12px;
        padding: 10px 18px;
        text-decoration: none;
        transition: 0.2s ease;
    }


        .btn-dark-custom:hover {
            background: #0b5ed7;
            border-color: #0b5ed7;
        }


    .password-wrapper {
        position: relative;
    }


    .toggle-password {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #6b7280;
        font-size: 1rem;
        user-select: none;
    }


        .toggle-password:hover {
            color: #1f2937;
        }


    .text-muted {
        color: #6b7280 !important;
    }


    label {
        margin-bottom: 6px;
        color: #374151;
        font-weight: 500;
    }


    h1 {
        color: #1f2937;
        font-weight: 700;
    }

</style>


<div class="page-container">

    <div class="card-dark">


        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h1>
                    Change Password
                </h1>

                <p class="text-muted mb-0">
                    Update your account password securely.
                </p>

            </div>


            <!-- BACK TO PROFILE -->
            <a href="#"
               class="btn-dark-custom ajax-link"
               data-url="@Url.Action("UpdateProfile", "Admin")">

                ← Profile

            </a>

        </div>


        <!-- CURRENT PASSWORD -->
        <div class="mb-4">

            <label class="form-label">
                Current Password
            </label>

            <div class="password-wrapper">

                <input type="password"
                       id="currentPassword"
                       class="form-control" />


                <span class="toggle-password"
                      onclick="togglePassword('currentPassword', this)">

                    <i class="fa-solid fa-eye"></i>

                </span>

            </div>

        </div>


        <!-- NEW PASSWORD -->
        <div class="mb-4">

            <label class="form-label">
                New Password
            </label>

            <div class="password-wrapper">

                <input type="password"
                       id="newPassword"
                       class="form-control" />


                <span class="toggle-password"
                      onclick="togglePassword('newPassword', this)">

                    <i class="fa-solid fa-eye"></i>

                </span>

            </div>

        </div>


        <!-- CONFIRM PASSWORD -->
        <div class="mb-4">

            <label class="form-label">
                Confirm New Password
            </label>

            <div class="password-wrapper">

                <input type="password"
                       id="confirmPassword"
                       class="form-control" />


                <span class="toggle-password"
                      onclick="togglePassword('confirmPassword', this)">

                    <i class="fa-solid fa-eye"></i>

                </span>

            </div>

        </div>


        <!-- ACTIONS -->
        <div class="mt-4">

            <button type="button"
                    class="btn-dark-custom me-2">

                Update Password

            </button>


            <button type="button"
                    class="btn-dark-custom"
                    onclick="clearPasswordFields()">

                Clear

            </button>

        </div>

    </div>

</div>


<script>

    function togglePassword(fieldId, element) {

        const field = document.getElementById(fieldId);

        const icon = element.querySelector("i");


        if (field.type === "password") {

            field.type = "text";

            icon.classList.remove("fa-eye");

            icon.classList.add("fa-eye-slash");

        }
        else {

            field.type = "password";

            icon.classList.remove("fa-eye-slash");

            icon.classList.add("fa-eye");

        }

    }


    function clearPasswordFields() {

        document.getElementById("currentPassword").value = "";

        document.getElementById("newPassword").value = "";

        document.getElementById("confirmPassword").value = "";

    }

</script>
